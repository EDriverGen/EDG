:name: ssd1306_eval
:description: I2C vector test for ssd1306

$bin = @<RUN_DIR>/attempts/003/stage/out/ssd1306_zephyr.elf

mach create "ssd1306_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/003/stage/probe/platform_init_and_display_off.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
