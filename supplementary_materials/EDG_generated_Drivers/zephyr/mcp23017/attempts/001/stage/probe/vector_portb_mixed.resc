:name: mcp23017_eval
:description: I2C vector test for mcp23017

$bin = @<RUN_DIR>/attempts/001/stage/out/mcp23017_zephyr.elf

mach create "mcp23017_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/001/stage/probe/platform_portb_mixed.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
