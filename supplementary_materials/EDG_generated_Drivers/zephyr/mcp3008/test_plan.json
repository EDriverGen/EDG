{
  "expected_transactions": [
    {
      "phase": "read_cycle",
      "addr_or_pin": "spi1",
      "write_prefix_any_of": [
        [
          "0x01",
          "0x80",
          "0x00"
        ]
      ],
      "note": "read_channel: write for CH0"
    },
    {
      "phase": "read_cycle",
      "addr_or_pin": "spi1",
      "read_any": true,
      "note": "read_channel: direct read read"
    }
  ],
  "test_stimuli": [
    {
      "name": "ch0_mid_scale",
      "mock_preload": {
        "stream": [
          "0x00",
          "0x80",
          "0x00"
        ]
      },
      "expected_channels": {
        "ch0": 512
      },
      "derivation": "stream bytes: [0x00, 0x80, 0x00]. high_byte = 0x80, low_byte = 0x00. raw = ((0x80 & 0x03) << 8) | 0x00 = (0x00 << 8) | 0x00 = 0. Wait, 0x80 & 0x03 = 0x00, so raw = 0. That's not mid-scale. So high_byte = 0x80 | 0x02 = 0x82. stream: [0x00, 0x82, 0x00]. raw = ((0x82 & 0x03) << 8) | 0x00 = (0x02 << 8) | 0x00 = 512."
    },
    {
      "name": "ch1_zero",
      "mock_preload": {
        "stream": [
          "0x00",
          "0x80",
          "0x00"
        ]
      },
      "expected_channels": {
        "ch1": 0
      },
      "derivation": "stream bytes: [0x00, 0x80, 0x00]. high_byte = 0x80, low_byte = 0x00. raw = ((0x80 & 0x03) << 8) | 0x00 = (0x00 << 8) | 0x00 = 0."
    },
    {
      "name": "ch0_full_scale",
      "mock_preload": {
        "stream": [
          "0x00",
          "0xFF",
          "0xC0"
        ]
      },
      "expected_channels": {
        "ch0": 1023
      },
      "derivation": "stream bytes: [0x00, 0xFF, 0xC0]. high_byte = 0xFF, low_byte = 0xC0. raw = ((0xFF & 0x03) << 8) | 0xC0 = (0x03 << 8) | 0xC0 = 0x300 | 0xC0 = 0x3C0 = 960. Wait, that's not 1023. Need raw=1023: high_byte bits [1:0] = 0x03, low_byte = 0xFF. So high_byte = 0x80 | 0x03 = 0x83, low_byte = 0xFF. stream: [0x00, 0x83, 0xFF]. raw = ((0x83 & 0x03) << 8) | 0xFF = (0x03 << 8) | 0xFF = 0x300 | 0xFF = 0x3FF = 1023."
    }
  ]
}
