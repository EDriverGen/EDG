{
  "eval_class": "multi_channel",
  "init_call": "dht22_init(&g_eval_dev, g_sensor_gpio)",
  "channels": [
    {
      "id": "humidity",
      "call": "dht22_read(&g_eval_dev, &humidity_val, &temp_val)",
      "out_arg": "humidity_val",
      "out_type": "int32_t",
      "physical_unit": "milli_percent_rh"
    },
    {
      "id": "temp",
      "call": "dht22_read(&g_eval_dev, &humidity_val, &temp_val)",
      "out_arg": "temp_val",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    }
  ],
  "dev_struct_type": "struct dht22_data",
  "init_extra_setup_c": "const struct device *g_sensor_gpio = device_get_binding(bus_name);\nif (g_sensor_gpio == NULL) { return DRIVERGEN_EVAL_ERR_INVALID; }",
  "preamble_c": "#include <zephyr/kernel.h>\n#include <zephyr/drivers/gpio.h>\n#include <errno.h>"
}
