:name: adxl345_eval
:description: SPI vector test for adxl345

$bin = @<RUN_DIR>/attempts/002/stage/out/adxl345_zephyr.elf

mach create "adxl345_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/002/stage/probe/spi_platform_mechanical_register_mapped_2.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
