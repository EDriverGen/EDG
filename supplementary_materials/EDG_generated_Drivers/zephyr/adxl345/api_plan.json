{
  "eval_class": "multi_channel",
  "init_call": "adxl345_init(g_eval_dev)",
  "channels": [
    {
      "id": "accel_x",
      "call": "adxl345_read_xyz(g_eval_dev, &ax, &ay, &az)",
      "out_arg": "ax",
      "out_type": "int16_t",
      "physical_unit": "raw_count"
    },
    {
      "id": "accel_y",
      "call": "adxl345_read_xyz(g_eval_dev, &ax, &ay, &az)",
      "out_arg": "ay",
      "out_type": "int16_t",
      "physical_unit": "raw_count"
    },
    {
      "id": "accel_z",
      "call": "adxl345_read_xyz(g_eval_dev, &ax, &ay, &az)",
      "out_arg": "az",
      "out_type": "int16_t",
      "physical_unit": "raw_count"
    }
  ],
  "dev_struct_type": "const struct device *",
  "init_extra_setup_c": "g_eval_dev = device_get_binding(bus_name);\nif (g_eval_dev == NULL) { return DRIVERGEN_EVAL_ERR_INVALID; }",
  "preamble_c": "#include <zephyr/kernel.h>\n#include <zephyr/drivers/spi.h>"
}
