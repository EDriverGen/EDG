{
  "eval_class": "multi_channel",
  "init_call": "tmp421_init(g_eval_dev)",
  "channels": [
    {
      "id": "temp_local",
      "call": "tmp421_read_temperature_local(g_eval_dev, &temp_local_val)",
      "out_arg": "temp_local_val",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    },
    {
      "id": "temp_remote",
      "call": "tmp421_read_temperature_remote1(g_eval_dev, &temp_remote_val)",
      "out_arg": "temp_remote_val",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    }
  ],
  "dev_struct_type": "const struct device *",
  "init_extra_setup_c": "g_eval_dev = device_get_binding(bus_name);\nif (g_eval_dev == NULL) { return DRIVERGEN_EVAL_ERR_INVALID; }"
}
