      "expected_channels": {
        "pressure": -1,
        "temp": -1
      },
      "derivation": "pressure: bytes 0xFF,0xFF,0xFF -> raw = -1 (24-bit two's complement); temp: bytes 0xFF,0xFF,0xFF -> raw = -1"
