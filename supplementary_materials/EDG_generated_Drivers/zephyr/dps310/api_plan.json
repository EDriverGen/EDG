{
  "eval_class": "multi_channel",
  "init_call": "dps310_init(g_eval_dev)",
  "channels": [
    {
      "id": "pressure",
      "call": "dps310_read_pressure(g_eval_dev, &pressure_raw)",
      "out_arg": "pressure_raw",
      "out_type": "int32_t",
      "physical_unit": "raw_count"
    },
    {
      "id": "temp",
      "call": "dps310_read_temp(g_eval_dev, &temp_raw)",
      "out_arg": "temp_raw",
      "out_type": "int32_t",
      "physical_unit": "raw_count"
    }
  ],
  "dev_struct_type": "const struct device *",
  "init_extra_setup_c": "g_eval_dev = device_get_binding(bus_name);\nif (g_eval_dev == NULL) { return DRIVERGEN_EVAL_ERR_INVALID; }"
}
