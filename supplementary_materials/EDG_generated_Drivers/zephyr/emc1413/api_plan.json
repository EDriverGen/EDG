{
  "eval_class": "multi_channel",
  "init_call": "emc1413_init(g_eval_dev)",
  "channels": [
    {
      "id": "temp_local",
      "call": "emc1413_read_internal_temperature(g_eval_dev, &temp_local_val)",
      "out_arg": "temp_local_val",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    },
    {
      "id": "temp_ext1",
      "call": "emc1413_read_external_diode_1_temperature(g_eval_dev, &temp_ext1_val)",
      "out_arg": "temp_ext1_val",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    },
    {
      "id": "temp_ext2",
      "call": "emc1413_read_external_diode_2_temperature(g_eval_dev, &temp_ext2_val)",
      "out_arg": "temp_ext2_val",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    }
  ],
  "dev_struct_type": "const struct device *",
  "init_extra_setup_c": "g_eval_dev = device_get_binding(bus_name);\nif (g_eval_dev == NULL) { return DRIVERGEN_EVAL_ERR_INVALID; }",
  "preamble_c": "#include <zephyr/kernel.h>\n#include <zephyr/drivers/i2c.h>"
}
