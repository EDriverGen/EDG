{
  "eval_class": "multi_channel",
  "init_call": "sht30_init(g_eval_dev)",
  "channels": [
    {
      "id": "temp",
      "call": "sht30_read_measurement(g_eval_dev, &temp_val, &hum_val)",
      "out_arg": "temp_val",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    },
    {
      "id": "humidity",
      "call": "sht30_read_measurement(g_eval_dev, &temp_val, &hum_val)",
      "out_arg": "hum_val",
      "out_type": "int32_t",
      "physical_unit": "milli_percent"
    }
  ],
  "dev_struct_type": "const struct device *",
  "init_extra_setup_c": "g_eval_dev = device_get_binding(bus_name);\nif (g_eval_dev == NULL) { return DRIVERGEN_EVAL_ERR_INVALID; }"
}
