{
  "eval_class": "multi_channel",
  "init_call": "pca9685_init(&g_eval_dev, g_eval_dev->bus)",
  "channels": [
    {
      "id": "led0",
      "call": "pca9685_read_pwm_channel(&g_eval_dev, 0, &led0)",
      "out_arg": "led0",
      "out_type": "uint16_t",
      "physical_unit": "raw"
    },
    {
      "id": "led1",
      "call": "pca9685_read_pwm_channel(&g_eval_dev, 1, &led1)",
      "out_arg": "led1",
      "out_type": "uint16_t",
      "physical_unit": "raw"
    }
  ],
  "dev_struct_type": "struct pca9685_dev",
  "init_extra_setup_c": "g_eval_dev.bus = device_get_binding(bus_name);\nif (g_eval_dev.bus == NULL) { return DRIVERGEN_EVAL_ERR_INVALID; }",
  "preamble_c": "#include <zephyr/kernel.h>\n#include <zephyr/drivers/i2c.h>"
}
