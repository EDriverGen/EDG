{
  "expected_transactions": [
    {
      "phase": "read_cycle",
      "addr_or_pin": "0x71",
      "write_prefix_any_of": [
        [
          "0x08"
        ]
      ],
      "note": "read_pwm_channel: write pointer to LED0_OFF_L"
    },
    {
      "phase": "read_cycle",
      "addr_or_pin": "0x71",
      "read_any": true,
      "note": "read_pwm_channel: direct read 4 bytes"
    }
  ],
  "test_stimuli": [
    {
      "name": "pwm_50_percent",
      "mock_preload": {
        "0x08": [
          "0x00",
          "0x08",
          "0x00",
          "0x00"
        ]
      },
      "expected_channels": {
        "led0": 2048,
        "led1": 0
      },
      "derivation": "led0: off_l=0x00, off_h=0x08 => ((0x08 & 0x0F)*256)+0x00 = 2048; led1: off_l=0x00, off_h=0x00 => 0"
    },
    {
      "name": "pwm_0_percent",
      "mock_preload": {
        "0x08": [
          "0x00",
          "0x00",
          "0x00",
          "0x00"
        ]
      },
      "expected_channels": {
        "led0": 0,
        "led1": 0
      },
      "derivation": "all bytes zero => both channels 0"
    },
    {
      "name": "pwm_full_scale",
      "mock_preload": {
        "0x08": [
          "0xFF",
          "0x0F",
          "0xFF",
          "0x0F"
        ]
      },
      "expected_channels": {
        "led0": 4095,
        "led1": 4095
      },
      "derivation": "led0: off_l=0xFF, off_h=0x0F => ((0x0F & 0x0F)*256)+0xFF = 4095; led1 same"
    }
  ]
}
