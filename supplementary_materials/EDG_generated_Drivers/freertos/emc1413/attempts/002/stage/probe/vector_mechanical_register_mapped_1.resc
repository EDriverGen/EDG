:name: emc1413_eval
:description: I2C vector test for emc1413

$bin = @<RUN_DIR>/attempts/002/stage/out/emc1413_freertos.elf

mach create "emc1413_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/002/stage/probe/platform_mechanical_register_mapped_1.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
