:name: dps310_eval
:description: I2C vector test for dps310

$bin = @<RUN_DIR>/attempts/003/stage/out/dps310_freertos.elf

mach create "dps310_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/003/stage/probe/platform_zero_pressure_and_temp.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
