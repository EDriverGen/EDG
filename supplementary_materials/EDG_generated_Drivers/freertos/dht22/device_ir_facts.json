  "evidence_spans": [
    {
      "source_id": "dht22",
      "page": 2,
      "snippet": "Resolution or sensitivity | humidity 0.1%RH;               | temperature 0.1Celsius"
    },
    {
      "source_id": "dht22",
      "page": 1,
      "snippet": "Output signal   | digital signal via single-bus"
    },
    {
      "source_id": "dht22",
      "page": 2,
      "snippet": "When power is supplied to sensor, don't send any instruction to the sensor within one second"
    },
    {
      "source_id": "dht22",
      "page": 3,
      "snippet": "DATA=8 bit integral RH data+8 bit decimal RH data+8 bit integral T data+8 bit decimal T data+8 bit checksum"
    },
    {
      "source_id": "dht22",
      "page": 4,
      "snippet": "Data-bus's free status is high voltage level. When communication between MCU and AM2303 begin, program of MCU will transform data-bus's voltage level from high to low level and this process must beyond at least 18ms"
    },
    {
      "source_id": "dht22",
      "page": 4,
      "snippet": "then MCU will wait 20-40us for AM2303's response"
    },
    {
      "source_id": "dht22",
      "page": 4,
      "snippet": "AM2303 will send out low-voltage-level signal and this signal last 80us as response signal"
    },
    {
      "source_id": "dht22",
      "page": 5,
      "snippet": "every bit's transmission begin with low-voltage-level that last 50us"
    },
    {
      "source_id": "dht22",
      "page": 6,
      "snippet": "70us voltage-length means 1bit data \"1\""
    }
