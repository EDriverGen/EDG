:name: max31855_eval
:description: SPI vector test for max31855

$bin = @<RUN_DIR>/attempts/001/stage/out/max31855_freertos.elf

mach create "max31855_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/001/stage/probe/spi_platform_mechanical_spi_stream_bitfield_1.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
