:name: at24c256_eval
:description: I2C vector test for at24c256

$bin = @<RUN_DIR>/attempts/001/stage/out/at24c256_rtems.elf

mach create "at24c256_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/001/stage/probe/platform_mechanical_memory_probe_1.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
