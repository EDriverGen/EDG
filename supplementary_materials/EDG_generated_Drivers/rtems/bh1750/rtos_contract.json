    "helper_usage_patterns": [
      {
        "pattern_id": "rtems_devfs_i2c_posix_transfer",
        "applies_to": "i2c.transfer",
        "purpose": "Use the RTEMS devfs I2C node named by bus_instance as the bus handle; do not cast that path string to i2c_bus*.",
        "required_symbols": [
          "open",
          "ioctl",
          "close"
        ],
        "required_types": [
          "struct i2c_msg",
          "struct i2c_rdwr_ioctl_data"
        ],
        "required_constants": [
          "O_RDWR",
          "I2C_RDWR",
          "I2C_M_RD"
        ],
        "required_headers": [
          "dev/i2c/i2c.h",
          "fcntl.h",
          "sys/ioctl.h",
          "unistd.h"
        ],
        "steps": [
          "Treat adapter bus_name / bus_instance as a const char * devfs path such as /dev/i2c-0.",
          "Open the path with open(path, O_RDWR).",
          "Build struct i2c_msg array entries with the 7-bit slave address.",
          "Wrap the message array in struct i2c_rdwr_ioctl_data.",
          "Submit the transfer with ioctl(fd, I2C_RDWR, &rdwr), then close(fd)."
        ]
      }
    ],
