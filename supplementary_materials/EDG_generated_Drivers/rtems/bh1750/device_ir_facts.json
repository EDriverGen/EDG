  "evidence_spans": [
    {
      "source_id": "bh1750",
      "page": 1,
      "snippet": "BH1750FVI is an digital Ambient Light Sensor IC for I2C bus interface."
    },
    {
      "source_id": "bh1750",
      "page": 1,
      "snippet": "It is possible to select 2 type of I2C slave-address."
    },
    {
      "source_id": "bh1750",
      "page": 2,
      "snippet": "H-Resolution Mode Measurement Time tHR - 120 180 ms"
    },
    {
      "source_id": "bh1750",
      "page": 2,
      "snippet": "L-Resolution Mode Measurement Time tLR - 16 24 ms"
    },
    {
      "source_id": "bh1750",
      "page": 4,
      "snippet": "Data Register → This is for registration of Ambient Light Data. Initial Value is \"0000_0000_0000_0000\"."
    },
    {
      "source_id": "bh1750",
      "page": 5,
      "snippet": "Instruction Opecode"
    },
    {
      "source_id": "bh1750",
      "page": 5,
      "snippet": "Power On 0000_0001 Waiting for measurement command."
    },
    {
      "source_id": "bh1750",
      "page": 5,
      "snippet": "Reset command is for only reset Illuminance data register. ( reset value is '0' )"
    },
    {
      "source_id": "bh1750",
      "page": 7,
      "snippet": "Read measurement result."
    },
    {
      "source_id": "bh1750",
      "page": 10,
      "snippet": "ADDR = 'H'  ( ADDR ≧ 0.7VCC ) → \"1011100\""
    },
    {
      "source_id": "bh1750",
      "page": 10,
      "snippet": "ADDR = 'L'  ( ADDR ≦ 0.3VCC ) → \"0100011\""
    },
    {
      "source_id": "bh1750",
      "page": 11,
      "snippet": "The below formula is to calculate illuminance per 1 count."
    },
    {
      "source_id": "bh1750",
      "page": 11,
      "snippet": "H-reslution mode : Illuminance per 1 count ( lx / count )  = 1 / 1.2 *( 69 / X )"
    },
    {
      "source_id": "bh1750",
      "page": 13,
      "snippet": "DVI Terminal is also asynchronous Reset for internal registers."
