{
  "eval_class": "multi_channel",
  "init_call": "pca9685_init(&g_eval_dev, bus_handle)",
  "channels": [
    {
      "id": "led0",
      "call": "pca9685_read_pwm_channel(&g_eval_dev, 0, &led0)",
      "out_arg": "led0",
      "out_type": "uint16_t",
      "physical_unit": "raw"
    },
    {
      "id": "led1",
      "call": "pca9685_read_pwm_channel(&g_eval_dev, 1, &led1)",
      "out_arg": "led1",
      "out_type": "uint16_t",
      "physical_unit": "raw"
    }
  ],
  "dev_struct_type": "struct pca9685_device",
  "init_extra_setup_c": "int fd = open(bus_name, O_RDWR);\nif (fd < 0) { return DRIVERGEN_EVAL_ERR_IO; }\nstruct pca9685_device *dev = &g_eval_dev;\ndev->fd = fd;\ndev->addr = 0x40;\nbus_handle = dev;",
  "preamble_c": "#include <dev/i2c/i2c.h>\n#include <linux/i2c-dev.h>\n#include <linux/i2c.h>\n#include <fcntl.h>\n#include <sys/ioctl.h>\n#include <unistd.h>"
}
