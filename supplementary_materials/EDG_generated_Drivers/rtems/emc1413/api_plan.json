{
  "eval_class": "multi_channel",
  "init_call": "emc1413_init(&g_eval_dev, bus_handle)",
  "channels": [
    {
      "id": "temp_local",
      "call": "emc1413_read_internal_temperature(&g_eval_dev, &temp_local_val)",
      "out_arg": "temp_local_val",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    },
    {
      "id": "temp_ext1",
      "call": "emc1413_read_external_diode_1_temperature(&g_eval_dev, &temp_ext1_val)",
      "out_arg": "temp_ext1_val",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    },
    {
      "id": "temp_ext2",
      "call": "emc1413_read_external_diode_2_temperature(&g_eval_dev, &temp_ext2_val)",
      "out_arg": "temp_ext2_val",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    }
  ],
  "dev_struct_type": "struct emc1413_dev",
  "init_extra_setup_c": "int fd = open(bus_name, O_RDWR);\nif (fd < 0) { return DRIVERGEN_EVAL_ERR_IO; }\nstruct emc1413_dev *dev = &g_eval_dev;\ndev->fd = fd;\nvoid *bus_handle = (void *)dev;"
}
