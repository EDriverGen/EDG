{
  "eval_class": "multi_channel",
  "init_call": "bme280_init(&g_eval_dev, bus_handle)",
  "channels": [
    {
      "id": "temp",
      "call": "bme280_read_all(&g_eval_dev, &temp_raw, &pressure_raw, &humidity_raw)",
      "out_arg": "temp_raw",
      "out_type": "int32_t",
      "physical_unit": "raw_count"
    },
    {
      "id": "pressure",
      "call": "bme280_read_all(&g_eval_dev, &temp_raw, &pressure_raw, &humidity_raw)",
      "out_arg": "pressure_raw",
      "out_type": "int32_t",
      "physical_unit": "raw_count"
    },
    {
      "id": "humidity",
      "call": "bme280_read_all(&g_eval_dev, &temp_raw, &pressure_raw, &humidity_raw)",
      "out_arg": "humidity_raw",
      "out_type": "int32_t",
      "physical_unit": "raw_count"
    }
  ],
  "dev_struct_type": "struct bme280_dev",
  "init_extra_setup_c": "int fd = open(bus_name, O_RDWR);\nif (fd < 0) return DRIVERGEN_EVAL_ERR_IO;\ng_eval_dev.fd = fd;",
  "preamble_c": "#include <dev/i2c/i2c.h>\n#include <linux/i2c-dev.h>\n#include <linux/i2c.h>\n#include <sys/ioctl.h>\n#include <fcntl.h>\n#include <unistd.h>"
}
