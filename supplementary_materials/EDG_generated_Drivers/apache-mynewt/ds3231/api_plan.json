{
  "eval_class": "rtc",
  "init_call": "ds3231_init(&g_eval_dev, bus_handle)",
  "get_time_call": "ds3231_get_time(&g_eval_dev, &drv)",
  "set_time_call": "ds3231_set_time(&g_eval_dev, &drv)",
  "time_struct_decl": "struct ds3231_time drv;",
  "time_struct_from_in": "struct ds3231_time drv = { .year = in->year - 2000, .month = in->month, .day = in->day, .hour = in->hour, .minute = in->minute, .second = in->second, .weekday = in->weekday };",
  "time_fields": {
    "year": "drv.year + 2000",
    "month": "drv.month",
    "day": "drv.day",
    "hour": "drv.hour",
    "minute": "drv.minute",
    "second": "drv.second",
    "weekday": "drv.weekday"
  },
  "dev_struct_type": "struct ds3231_dev",
  "init_extra_setup_c": "void *bus_handle = (void *)bus_name;",
  "preamble_c": "#include <hal/hal_i2c.h>\n#include <os/os_time.h>"
}
