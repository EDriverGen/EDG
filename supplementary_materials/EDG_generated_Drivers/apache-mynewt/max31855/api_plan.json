{
  "eval_class": "multi_channel",
  "init_call": "max31855_init(&g_eval_dev, bus_handle)",
  "init_extra_setup_c": "void *bus_handle = (void *)bus_name;",
  "dev_struct_type": "struct max31855_dev",
  "channels": [
    {
      "id": "thermocouple",
      "call": "max31855_read_temperatures(&g_eval_dev, &thermocouple_val, &internal_val)",
      "out_arg": "thermocouple_val",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    },
    {
      "id": "temp_local",
      "call": "max31855_read_temperatures(&g_eval_dev, &thermocouple_val, &internal_val)",
      "out_arg": "internal_val",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    }
  ]
}
