  "evidence_spans": [
    {
      "source_id": "bh1750",
      "page": 10,
      "snippet": "Slave Address is 2 types, it is determined by ADDR Terminal"
    },
    {
      "source_id": "bh1750",
      "page": 10,
      "snippet": "ADDR = 'H'    ( ADDR ≧ 0.7VCC ) → '1011100'"
    },
    {
      "source_id": "bh1750",
      "page": 10,
      "snippet": "ADDR = 'L'    ( ADDR ≦ 0.3VCC ) → '0100011'"
    },
    {
      "source_id": "bh1750",
      "page": 5,
      "snippet": "Power Down                           0000_0000"
