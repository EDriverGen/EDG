{
  "eval_class": "multi_channel",
  "init_call": "dht22_init(&g_eval_dev, PB5)",
  "channels": [
    {
      "id": "humidity",
      "call": "dht22_read_sensor(&g_eval_dev, &humidity_val, &temp_val)",
      "out_arg": "humidity_val",
      "out_type": "int32_t",
      "physical_unit": "milli_percent_rh"
    },
    {
      "id": "temp",
      "call": "dht22_read_sensor(&g_eval_dev, &humidity_val, &temp_val)",
      "out_arg": "temp_val",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    }
  ],
  "dev_struct_type": "struct dht22_dev",
  "init_extra_setup_c": "",
  "preamble_c": ""
}
