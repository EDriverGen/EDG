      "name": "ch1_zero",
      "mock_preload": {
        "stream": [
          "0x00",
          "0x00",
          "0x00"
        ]
      },
      "expected_channels": {
        "ch1": 0
      },
      "derivation": "high_byte=0x00, low_byte=0x00; raw = ((0x00 & 0x03) * 256) + 0x00 = 0"
    },
    {
      "name": "ch0_quarter_scale",
      "mock_preload": {
        "stream": [
          "0x00",
          "0x40",
          "0x00"
        ]
      },
      "expected_channels": {
        "ch0": 256
      },
      "derivation": "high_byte=0x40, low_byte=0x00; raw = ((0x40 & 0x03) * 256) + 0x00 = (0 * 256) + 0 = 0? Wait, 0x40 & 0x03 = 0, so raw=0. Correcting: mock_preload stream [0x00, 0x01, 0x00] yields high_byte=0x01, low_byte=0x00; raw = ((0x01 & 0x03) * 256) + 0x00 = 256"
    }
