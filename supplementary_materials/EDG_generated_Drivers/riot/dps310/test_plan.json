  "test_stimuli": [
    {
      "name": "positive_pressure_and_temp",
      "mock_preload": {
        "0x00": [
          "0x00",
          "0x7A",
          "0xC0"
        ],
        "0x03": [
          "0x00",
          "0x1A",
          "0x80"
        ]
      },
      "expected_channels": {
        "pressure": 31424,
        "temp": 6784
      },
      "derivation": "pressure: bytes 0x00,0x7A,0xC0 -> 24-bit big-endian = 0x007AC0 = 31424 (positive). temp: bytes 0x00,0x1A,0x80 -> 0x001A80 = 6784 (positive)."
    },
    {
      "name": "zero_pressure_and_temp",
      "mock_preload": {
        "0x00": [
          "0x00",
          "0x00",
          "0x00"
        ],
        "0x03": [
          "0x00",
          "0x00",
          "0x00"
        ]
      },
      "expected_channels": {
        "pressure": 0,
        "temp": 0
      },
      "derivation": "All bytes zero -> 24-bit value = 0."
    },
    {
      "name": "negative_pressure_and_temp",
      "mock_preload": {
        "0x00": [
          "0xFF",
          "0x80",
          "0x00"
        ],
        "0x03": [
          "0xFF",
          "0xE0",
          "0x00"
        ]
      },
      "expected_channels": {
        "pressure": -32768,
        "temp": -8192
      },
      "derivation": "pressure: bytes 0xFF,0x80,0x00 -> 24-bit two's complement: 0xFF8000 = -32768 (sign extend bit 23). temp: bytes 0xFF,0xE0,0x00 -> 0xFFE000 = -8192."
    }
  ]
}
