{
  "eval_class": "multi_channel",
  "init_call": "max31855_init(&g_eval_dev, SPI_DEV(0), SPI_HWCS(0))",
  "channels": [
    {
      "id": "thermocouple",
      "call": "max31855_read_temperatures(&g_eval_dev, &thermocouple_val, &internal_val)",
      "out_arg": "thermocouple_val",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    },
    {
      "id": "temp_local",
      "call": "max31855_read_temperatures(&g_eval_dev, &thermocouple_val, &internal_val)",
      "out_arg": "internal_val",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    }
  ],
  "dev_struct_type": "max31855_t",
  "init_extra_setup_c": ""
}
