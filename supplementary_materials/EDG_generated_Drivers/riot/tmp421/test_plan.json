{
  "expected_transactions": [
    {
      "phase": "init",
      "addr_or_pin": "0x2A",
      "write_prefix_any_of": [
        [
          "0xFE"
        ]
      ],
      "read_any": true,
      "note": "probe_identity: write_then_read"
    },
    {
      "phase": "init",
      "addr_or_pin": "0x2A",
      "write_prefix_any_of": [
        [
          "0xFF"
        ]
      ],
      "read_any": true,
      "note": "probe_identity: write_then_read"
    },
    {
      "phase": "read_cycle",
      "addr_or_pin": "0x2A",
      "write_prefix_any_of": [
        [
          "0x00"
        ]
      ],
      "read_any": true,
      "note": "read_temperature_local: write_then_read"
    },
    {
      "phase": "read_cycle",
      "addr_or_pin": "0x2A",
      "write_prefix_any_of": [
        [
          "0x10"
        ]
      ],
      "read_any": true,
      "note": "read_temperature_local: write_then_read"
    },
    {
      "phase": "read_cycle",
      "addr_or_pin": "0x2A",
      "write_prefix_any_of": [
        [
          "0x01"
        ]
      ],
      "read_any": true,
      "note": "read_temperature_remote1: write_then_read"
    },
    {
      "phase": "read_cycle",
      "addr_or_pin": "0x2A",
      "write_prefix_any_of": [
        [
          "0x11"
        ]
      ],
      "read_any": true,
      "note": "read_temperature_remote1: write_then_read"
    }
  ],
  "test_stimuli": [
    {
      "name": "local_positive_25C",
      "mock_preload": {
        "0x08": [
          "0x00"
        ],
        "0x00": [
          "0x19"
        ],
        "0x10": [
          "0x00"
        ]
      },
      "expected_channels": {
        "temp_local": 25000
      },
      "derivation": "high_byte=0x19=25, low_byte=0x00, combined=((25<<4)+(0>>4))*625/10=(400)*625/10=25000"
    },
    {
      "name": "local_zero",
      "mock_preload": {
        "0x08": [
          "0x00"
        ],
        "0x00": [
          "0x00"
        ],
        "0x10": [
          "0x00"
        ]
      },
      "expected_channels": {
        "temp_local": 0
      },
      "derivation": "high_byte=0x00=0, low_byte=0x00, combined=((0<<4)+(0>>4))*625/10=0"
    },
    {
      "name": "local_negative_10C",
      "mock_preload": {
        "0x08": [
          "0x00"
        ],
        "0x00": [
          "0xF6"
        ],
        "0x10": [
          "0x00"
        ]
      },
      "expected_channels": {
        "temp_local": -10000
      },
      "derivation": "high_byte=0xF6=-10 (signed), low_byte=0x00, combined=((-10<<4)+(0>>4))*625/10=(-160)*625/10=-10000"
    },
    {
      "name": "remote_positive_30C",
      "mock_preload": {
        "0x08": [
          "0x00"
        ],
        "0x01": [
          "0x1E"
        ],
        "0x11": [
          "0x00"
        ]
      },
      "expected_channels": {
        "temp_remote": 30000
      },
      "derivation": "high_byte=0x1E=30, low_byte=0x00, combined=((30<<4)+(0>>4))*625/10=(480)*625/10=30000"
    },
    {
      "name": "remote_zero",
      "mock_preload": {
        "0x08": [
          "0x00"
        ],
        "0x01": [
          "0x00"
        ],
        "0x11": [
          "0x00"
        ]
      },
      "expected_channels": {
        "temp_remote": 0
      },
      "derivation": "high_byte=0x00=0, low_byte=0x00, combined=((0<<4)+(0>>4))*625/10=0"
    },
    {
      "name": "remote_negative_5C",
      "mock_preload": {
        "0x08": [
          "0x00"
        ],
        "0x01": [
          "0xFB"
        ],
        "0x11": [
          "0x00"
        ]
      },
      "expected_channels": {
        "temp_remote": -5000
      },
      "derivation": "high_byte=0xFB=-5 (signed), low_byte=0x00, combined=((-5<<4)+(0>>4))*625/10=(-80)*625/10=-5000"
    }
  ]
}
