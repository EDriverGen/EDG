{
  "eval_class": "multi_channel",
  "init_call": "tmp421_init(&g_eval_dev, I2C_DEV(0), 0x2A)",
  "channels": [
    {
      "id": "temp_local",
      "call": "tmp421_read_local(&g_eval_dev, &temp_local_val)",
      "out_arg": "temp_local_val",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    },
    {
      "id": "temp_remote",
      "call": "tmp421_read_remote(&g_eval_dev, &temp_remote_val)",
      "out_arg": "temp_remote_val",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    }
  ],
  "dev_struct_type": "struct tmp421_device",
  "init_extra_setup_c": "i2c_t bus = I2C_DEV(0);\n(void)bus;"
}
