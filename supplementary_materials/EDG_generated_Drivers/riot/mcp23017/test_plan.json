{
  "expected_transactions": [
    {
      "phase": "init",
      "addr_or_pin": "0x20",
      "write_prefix_any_of": [
        [
          "0x00",
          "0x00"
        ]
      ],
      "note": "IODIRA = 0x00 (all outputs)"
    },
    {
      "phase": "init",
      "addr_or_pin": "0x20",
      "write_prefix_any_of": [
        [
          "0x01",
          "0x00"
        ]
      ],
      "note": "IODIRB = 0x00 (all outputs)"
    },
    {
      "phase": "read_porta",
      "addr_or_pin": "0x20",
      "write_prefix_any_of": [
        [
          "0x12"
        ]
      ],
      "note": "Set pointer to GPIOA"
    },
    {
      "phase": "read_porta",
      "addr_or_pin": "0x20",
      "write_prefix_any_of": [
        []
      ],
      "note": "Read GPIOA byte"
    },
    {
      "phase": "read_portb",
      "addr_or_pin": "0x20",
      "write_prefix_any_of": [
        [
          "0x13"
        ]
      ],
      "note": "Set pointer to GPIOB"
    },
    {
      "phase": "read_portb",
      "addr_or_pin": "0x20",
      "write_prefix_any_of": [
        []
      ],
      "note": "Read GPIOB byte"
    }
  ],
  "test_stimuli": [
    {
      "name": "porta_all_high_portb_all_low",
      "mock_preload": {
        "0x12": [
          "0xFF"
        ],
        "0x13": [
          "0x00"
        ]
      },
      "expected_channels": {
        "gpio_a0": 1,
        "gpio_a1": 1,
        "gpio_a2": 1,
        "gpio_a3": 1,
        "gpio_a4": 1,
        "gpio_a5": 1,
        "gpio_a6": 1,
        "gpio_a7": 1,
        "gpio_b0": 0,
        "gpio_b1": 0,
        "gpio_b2": 0,
        "gpio_b3": 0,
        "gpio_b4": 0,
        "gpio_b5": 0,
        "gpio_b6": 0,
        "gpio_b7": 0
      },
      "derivation": "porta_byte=0xFF => each bit=1; portb_byte=0x00 => each bit=0"
    },
    {
      "name": "porta_mixed_portb_mixed",
      "mock_preload": {
        "0x12": [
          "0x55"
        ],
        "0x13": [
          "0xAA"
        ]
      },
      "expected_channels": {
        "gpio_a0": 1,
        "gpio_a1": 0,
        "gpio_a2": 1,
        "gpio_a3": 0,
        "gpio_a4": 1,
        "gpio_a5": 0,
        "gpio_a6": 1,
        "gpio_a7": 0,
        "gpio_b0": 0,
        "gpio_b1": 1,
        "gpio_b2": 0,
        "gpio_b3": 1,
        "gpio_b4": 0,
        "gpio_b5": 1,
        "gpio_b6": 0,
        "gpio_b7": 1
      },
      "derivation": "porta_byte=0x55 => bits 0,2,4,6=1; portb_byte=0xAA => bits 1,3,5,7=1"
    },
    {
      "name": "porta_zero_portb_zero",
      "mock_preload": {
        "0x12": [
          "0x00"
        ],
        "0x13": [
          "0x00"
        ]
      },
      "expected_channels": {
        "gpio_a0": 0,
        "gpio_a1": 0,
        "gpio_a2": 0,
        "gpio_a3": 0,
        "gpio_a4": 0,
        "gpio_a5": 0,
        "gpio_a6": 0,
        "gpio_a7": 0,
        "gpio_b0": 0,
        "gpio_b1": 0,
        "gpio_b2": 0,
        "gpio_b3": 0,
        "gpio_b4": 0,
        "gpio_b5": 0,
        "gpio_b6": 0,
        "gpio_b7": 0
      },
      "derivation": "both bytes 0x00 => all bits 0"
    }
  ]
}
