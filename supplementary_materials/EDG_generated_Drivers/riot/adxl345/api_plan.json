      "out_type": "int16_t",
      "physical_unit": "raw_count"
    },
    {
      "id": "accel_z",
      "call": "adxl345_read_xyz(&g_eval_dev, &ax, &ay, &az)",
      "out_arg": "az",
      "out_type": "int16_t",
      "physical_unit": "raw_count"
    }
  ],
  "dev_struct_type": "adxl345_t",
  "init_extra_setup_c": ""
