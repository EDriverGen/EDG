  "registers_or_commands": [
    {
      "name": "Pointer Register",
      "value": "0x00",
      "access": "wo",
      "size_bits": 8,
      "description": "8-bit register used to address data registers; two LSBs (P1,P0) select register. Power-up reset value P1/P0=00."
    },
    {
      "name": "Temperature Register",
      "value": "0x00",
      "access": "ro",
      "size_bits": 16,
      "description": "12-bit read-only register storing most recent conversion output. Two bytes: MSB first, LSB second. Unused LSBs zero."
    },
    {
      "name": "Configuration Register",
      "value": "0x01",
      "access": "rw",
      "size_bits": 8,
      "description": "8-bit read/write register controlling operational modes. Power-up/reset value all bits 0."
    },
    {
      "name": "T LOW Register",
      "value": "0x02",
      "access": "rw",
      "size_bits": 16,
      "description": "12-bit low temperature limit register. Two bytes: MSB first, LSB second. LSB bits D3-D0 zero. All 12 bits used in ALERT comparisons."
    },
    {
      "name": "T HIGH Register",
      "value": "0x03",
      "access": "rw",
      "size_bits": 16,
      "description": "12-bit high temperature limit register. Two bytes: MSB first, LSB second. LSB bits D3-D0 zero. All 12 bits used in ALERT comparisons."
    }
  ],
  "bitfields": [
    {
      "register": "Pointer Register",
      "name": "P1-P0",
      "bits": "1:0",
      "access": "wo",
      "description": "Selects register: 00=Temperature, 01=Configuration, 10=T LOW, 11=T HIGH"
    },
    {
      "register": "Configuration Register",
      "name": "OS",
      "bits": "7",
      "access": "rw",
      "description": "One-Shot: write 1 to start single conversion in shutdown mode; reads as 0"
    },
    {
      "register": "Configuration Register",
      "name": "R1-R0",
      "bits": "6:5",
      "access": "rw",
      "description": "Converter resolution: 00=9-bit, 01=10-bit, 10=11-bit, 11=12-bit"
    },
    {
      "register": "Configuration Register",
      "name": "F1-F0",
      "bits": "4:3",
      "access": "rw",
      "description": "Fault queue: number of consecutive faults to trigger alert: 00=1, 01=2, 10=4, 11=6"
    },
    {
      "register": "Configuration Register",
      "name": "POL",
      "bits": "2",
      "access": "rw",
      "description": "ALERT polarity: 0=active low, 1=active high"
    },
    {
      "register": "Configuration Register",
      "name": "TM",
      "bits": "1",
      "access": "rw",
      "description": "Thermostat mode: 0=Comparator mode, 1=Interrupt mode"
    },
    {
      "register": "Configuration Register",
      "name": "SD",
      "bits": "0",
      "access": "rw",
      "description": "Shutdown mode: 1=shutdown after current conversion, 0=continuous conversion"
    },
    {
      "register": "Temperature Register",
      "name": "T11-T0",
      "bits": "15:4",
      "access": "ro",
      "description": "12-bit temperature data in two's complement format. Byte1 bits D7-D0 = T11-T4, Byte2 bits D7-D4 = T3-T0, Byte2 bits D3-D0 = 0."
    },
    {
      "register": "T LOW Register",
      "name": "L11-L0",
      "bits": "15:4",
      "access": "rw",
      "description": "12-bit low limit data. Byte1 bits D7-D0 = L11-L4, Byte2 bits D7-D4 = L3-L0, Byte2 bits D3-D0 = 0."
    },
    {
      "register": "T HIGH Register",
      "name": "H11-H0",
      "bits": "15:4",
      "access": "rw",
      "description": "12-bit high limit data. Byte1 bits D7-D0 = H11-H4, Byte2 bits D7-D4 = H3-H0, Byte2 bits D3-D0 = 0."
    }
  ],
