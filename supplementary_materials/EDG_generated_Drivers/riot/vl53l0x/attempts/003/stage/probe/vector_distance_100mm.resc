:name: vl53l0x_eval
:description: I2C vector test for vl53l0x

$bin = @<RUN_DIR>/attempts/003/stage/out/vl53l0x_riot.elf

mach create "vl53l0x_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/003/stage/probe/platform_distance_100mm.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
