{
  "eval_class": "multi_channel",
  "init_call": "sht30_init(&g_eval_dev, I2C_DEV(0))",
  "channels": [
    {
      "id": "temp",
      "call": "sht30_read_single_shot(&g_eval_dev, &temp_val, &hum_val)",
      "out_arg": "temp_val",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    },
    {
      "id": "humidity",
      "call": "sht30_read_single_shot(&g_eval_dev, &temp_val, &hum_val)",
      "out_arg": "hum_val",
      "out_type": "int32_t",
      "physical_unit": "milli_percent"
    }
  ],
  "dev_struct_type": "sht30_t",
  "init_extra_setup_c": ""
}
