{
  "eval_class": "multi_channel",
  "init_call": "bme280_init(&g_eval_dev, I2C_DEV(0))",
  "channels": [
    {
      "id": "temp",
      "call": "bme280_read_all(&g_eval_dev, &temp_raw, &pressure_raw, &humidity_raw)",
      "out_arg": "temp_raw",
      "out_type": "int32_t",
      "physical_unit": "raw_count"
    },
    {
      "id": "pressure",
      "call": "bme280_read_all(&g_eval_dev, &temp_raw, &pressure_raw, &humidity_raw)",
      "out_arg": "pressure_raw",
      "out_type": "int32_t",
      "physical_unit": "raw_count"
    },
    {
      "id": "humidity",
      "call": "bme280_read_all(&g_eval_dev, &temp_raw, &pressure_raw, &humidity_raw)",
      "out_arg": "humidity_raw",
      "out_type": "int32_t",
      "physical_unit": "raw_count"
    }
  ],
  "dev_struct_type": "bme280_t",
  "init_extra_setup_c": ""
}
