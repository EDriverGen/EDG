:name: bh1750_eval
:description: I2C vector test for bh1750

$bin = @<RUN_DIR>/attempts/001/stage/out/bh1750_riot.elf

mach create "bh1750_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/001/stage/probe/platform_low_light_100_lux.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
