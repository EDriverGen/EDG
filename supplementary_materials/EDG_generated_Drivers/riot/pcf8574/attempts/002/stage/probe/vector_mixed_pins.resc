:name: pcf8574_eval
:description: I2C vector test for pcf8574

$bin = @<RUN_DIR>/attempts/002/stage/out/pcf8574_riot.elf

mach create "pcf8574_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/002/stage/probe/platform_mixed_pins.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
