{
  "expected_transactions": [
    {
      "phase": "read_cycle",
      "addr_or_pin": "gpio1",
      "write_prefix_any_of": [
        [
          "0x44"
        ]
      ],
      "note": "convert_t: write"
    },
    {
      "phase": "read_cycle",
      "addr_or_pin": "gpio1",
      "read_any": true,
      "note": "convert_t: direct read read"
    }
  ],
  "test_stimuli": [
    {
      "name": "positive_temperature_25C",
      "mock_preload": {
        "payload": [
          "0x90",
          "0x01"
        ]
      },
      "expected_read_raw": 25000,
      "derivation": "raw_16bit = 0x0190 = 400; temperature = 400 * 0.0625 = 25.0 °C; milli_degC = 25.0 * 1000 = 25000"
    },
    {
      "name": "zero_temperature",
      "mock_preload": {
        "payload": [
          "0x00",
          "0x00"
        ]
      },
      "expected_read_raw": 0,
      "derivation": "raw_16bit = 0x0000 = 0; temperature = 0 * 0.0625 = 0.0 °C; milli_degC = 0"
    },
    {
      "name": "negative_temperature_minus10C",
      "mock_preload": {
        "payload": [
          "0x60",
          "0xFF"
        ]
      },
      "expected_read_raw": -10000,
      "derivation": "raw_16bit = 0xFF60 = -160 (signed); temperature = -160 * 0.0625 = -10.0 °C; milli_degC = -10.0 * 1000 = -10000"
    }
  ]
}
