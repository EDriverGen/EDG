{
  "eval_class": "multi_channel",
  "init_call": "mpu6050_init(&g_eval_dev, I2C_DEV(0))",
  "channels": [
    {
      "id": "accel_x",
      "call": "mpu6050_read_all(&g_eval_dev, &ax, &ay, &az, &temp, &gx, &gy, &gz)",
      "out_arg": "ax",
      "out_type": "int16_t",
      "physical_unit": "raw_count"
    },
    {
      "id": "accel_y",
      "call": "mpu6050_read_all(&g_eval_dev, &ax, &ay, &az, &temp, &gx, &gy, &gz)",
      "out_arg": "ay",
      "out_type": "int16_t",
      "physical_unit": "raw_count"
    },
    {
      "id": "accel_z",
      "call": "mpu6050_read_all(&g_eval_dev, &ax, &ay, &az, &temp, &gx, &gy, &gz)",
      "out_arg": "az",
      "out_type": "int16_t",
      "physical_unit": "raw_count"
    },
    {
      "id": "gyro_x",
      "call": "mpu6050_read_all(&g_eval_dev, &ax, &ay, &az, &temp, &gx, &gy, &gz)",
      "out_arg": "gx",
      "out_type": "int16_t",
      "physical_unit": "raw_count"
    },
    {
      "id": "gyro_y",
      "call": "mpu6050_read_all(&g_eval_dev, &ax, &ay, &az, &temp, &gx, &gy, &gz)",
      "out_arg": "gy",
      "out_type": "int16_t",
      "physical_unit": "raw_count"
    },
    {
      "id": "gyro_z",
      "call": "mpu6050_read_all(&g_eval_dev, &ax, &ay, &az, &temp, &gx, &gy, &gz)",
      "out_arg": "gz",
      "out_type": "int16_t",
      "physical_unit": "raw_count"
    },
    {
      "id": "temp",
      "call": "mpu6050_read_all(&g_eval_dev, &ax, &ay, &az, &temp, &gx, &gy, &gz)",
      "out_arg": "temp",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    }
  ],
  "dev_struct_type": "mpu6050_t",
  "init_extra_setup_c": "i2c_t bus = I2C_DEV(0);"
}
