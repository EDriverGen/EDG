      "description": "FIFO status: watermark, overrun, empty, fill level"
    },
    {
      "name": "INT1_CFG_A",
      "value": "0x30",
      "access": "rw",
      "size_bits": 8,
      "description": "Interrupt 1 configuration: AOI, 6D, axis enables"
    },
    {
      "name": "INT1_SOURCE_A",
