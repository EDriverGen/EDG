    {
      "name": "IRB_REG_M",
      "value": "0x0B",
      "access": "ro",
      "size_bits": 8,
      "description": "Magnetometer identification register B"
    },
    {
      "name": "IRC_REG_M",
      "value": "0x0C",
      "access": "ro",
      "size_bits": 8,
      "description": "Magnetometer identification register C"
