      "access": "ro",
      "size_bits": 8,
      "description": "Interrupt 1 source: IA, axis events"
    },
    {
      "name": "INT1_THS_A",
      "value": "0x32",
      "access": "rw",
      "size_bits": 8,
      "description": "Interrupt 1 threshold"
    },
    {
      "name": "INT1_DURATION_A",
      "value": "0x33",
      "access": "rw",
      "size_bits": 8,
      "description": "Interrupt 1 duration"
    },
    {
      "name": "INT2_CFG_A",
      "value": "0x34",
      "access": "rw",
      "size_bits": 8,
      "description": "Interrupt 2 configuration"
    },
    {
      "name": "INT2_SOURCE_A",
      "value": "0x35",
      "access": "ro",
      "size_bits": 8,
      "description": "Interrupt 2 source"
    },
    {
      "name": "INT2_THS_A",
      "value": "0x36",
      "access": "rw",
      "size_bits": 8,
      "description": "Interrupt 2 threshold"
    },
    {
      "name": "INT2_DURATION_A",
      "value": "0x37",
      "access": "rw",
      "size_bits": 8,
      "description": "Interrupt 2 duration"
    },
    {
      "name": "CLICK_CFG_A",
      "value": "0x38",
      "access": "rw",
      "size_bits": 8,
      "description": "Click configuration: double/single axis enables"
    },
    {
      "name": "CLICK_SRC_A",
      "value": "0x39",
      "access": "rw",
      "size_bits": 8,
      "description": "Click source: IA, DCLICK, SCLICK, sign, axis"
    },
    {
      "name": "CLICK_THS_A",
      "value": "0x3A",
      "access": "rw",
      "size_bits": 8,
      "description": "Click threshold"
    },
    {
      "name": "TIME_LIMIT_A",
      "value": "0x3B",
      "access": "rw",
      "size_bits": 8,
      "description": "Click time limit"
    },
    {
      "name": "TIME_LATENCY_A",
      "value": "0x3C",
      "access": "rw",
      "size_bits": 8,
      "description": "Click time latency"
    },
    {
      "name": "TIME_WINDOW_A",
      "value": "0x3D",
      "access": "rw",
      "size_bits": 8,
      "description": "Click time window"
    },
    {
