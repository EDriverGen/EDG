    },
    {
      "name": "OUT_Y_H_M",
      "value": "0x07",
      "access": "ro",
      "size_bits": 8,
      "description": "Magnetometer Y-axis high byte"
    },
    {
      "name": "OUT_Y_L_M",
      "value": "0x08",
