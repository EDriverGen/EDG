{
  "device_id": "lsm303dlhc",
  "bus_type": "i2c",
  "address_rule": {
    "type": "address_pins",
    "addressing_form": "7-bit",
    "addresses": [
      {
        "address": "0x19",
        "description": "Accelerometer default (factory) 7-bit slave address 0011001b",
        "is_default": true
      },
      {
        "address": "0x1E",
        "description": "Magnetometer default (factory) 7-bit slave address 0011110xb",
        "is_default": true
      }
    ]
  },
  "register_map": {
    "total_size_bytes": 64,
    "addressing": "1-byte",
    "auto_increment": true,
    "page_size_bytes": null,
    "write_busy_ms": null,
    "notes": "Two separate I2C interfaces: accelerometer registers 0x20-0x3D, magnetometer registers 0x00-0x32. Auto-increment enabled by setting MSB of sub-address."
  },
  "read_channels": [
    {
      "id": "accel_x",
      "raw_type": "int16",
      "physical_unit": "milli_g",
      "flow_id": "read_accel",
      "source_bytes": [
        "OUT_X_H_A",
        "OUT_X_L_A"
      ],
      "formula_id": "accel_from_raw"
    },
    {
      "id": "accel_y",
      "raw_type": "int16",
      "physical_unit": "milli_g",
      "flow_id": "read_accel",
      "source_bytes": [
        "OUT_Y_H_A",
        "OUT_Y_L_A"
      ],
      "formula_id": "accel_from_raw"
    },
    {
      "id": "accel_z",
      "raw_type": "int16",
      "physical_unit": "milli_g",
      "flow_id": "read_accel",
      "source_bytes": [
        "OUT_Z_H_A",
        "OUT_Z_L_A"
      ],
      "formula_id": "accel_from_raw"
    },
    {
      "id": "mag_x",
      "raw_type": "int16",
      "physical_unit": "milli_gauss",
      "flow_id": "read_mag",
      "source_bytes": [
        "OUT_X_H_M",
        "OUT_X_L_M"
      ],
      "formula_id": "mag_from_raw"
    },
    {
      "id": "mag_y",
      "raw_type": "int16",
      "physical_unit": "milli_gauss",
      "flow_id": "read_mag",
      "source_bytes": [
        "OUT_Y_H_M",
        "OUT_Y_L_M"
      ],
      "formula_id": "mag_from_raw"
    },
    {
      "id": "mag_z",
      "raw_type": "int16",
      "physical_unit": "milli_gauss",
      "flow_id": "read_mag",
      "source_bytes": [
        "OUT_Z_H_M",
        "OUT_Z_L_M"
      ],
      "formula_id": "mag_from_raw"
    },
    {
      "id": "temperature",
      "raw_type": "int16",
      "physical_unit": "milli_degC",
      "flow_id": "read_mag",
      "source_bytes": [
        "TEMP_OUT_H_M",
        "TEMP_OUT_L_M"
      ],
      "formula_id": "temp_from_raw"
    }
  ],
  "access_model": {
    "kind": "register_pointer",
    "address_bytes": 1,
    "read_requires_pointer": true,
    "direct_read_after_write": false,
    "notes": "Both accelerometer and magnetometer use register-pointer access. Auto-increment enabled by setting MSB of sub-address."
  },
  "operation_flows": [
    {
      "flow_id": "init_accel",
      "kind": "init",
      "channels": [
        "accel_x",
        "accel_y",
        "accel_z"
      ],
      "preconditions": [
        "Power supply stable"
      ],
      "steps": [
        {
          "op": "write",
          "transaction": {
            "kind": "write",
            "bytes": [
              "0x20",
              "0x57"
            ],
            "pointer_target": "CTRL_REG1_A"
          },
          "notes": "Set ODR=100Hz (0x0100), LPen=0, Zen=1, Yen=1, Xen=1 => 0x57"
        },
        {
          "op": "write",
          "transaction": {
            "kind": "write",
            "bytes": [
              "0x23",
              "0x08"
            ],
            "pointer_target": "CTRL_REG4_A"
          },
          "notes": "Set FS=±2g (00), HR=1 (high resolution) => 0x08"
        },
        {
          "op": "delay",
          "delay_ms": 70,
          "notes": "Wait for accelerometer turn-on time: 7/ODR = 7/100 = 70 ms (Table 8)."
        }
      ],
      "outputs": [
        {
          "channel": "accel_x",
          "byte_source": "OUT_X_H_A:8 || OUT_X_L_A:8",
          "formula_id": "accel_from_raw"
        },
        {
          "channel": "accel_y",
          "byte_source": "OUT_Y_H_A:8 || OUT_Y_L_A:8",
          "formula_id": "accel_from_raw"
        },
        {
          "channel": "accel_z",
          "byte_source": "OUT_Z_H_A:8 || OUT_Z_L_A:8",
          "formula_id": "accel_from_raw"
        }
      ],
      "notes": "Initializes accelerometer in normal mode, 100Hz ODR, ±2g full-scale, high resolution."
    },
    {
      "flow_id": "init_mag",
      "kind": "init",
      "channels": [
        "mag_x",
        "mag_y",
        "mag_z",
        "temperature"
      ],
      "preconditions": [
        "Power supply stable"
      ],
      "steps": [
        {
          "op": "write",
          "transaction": {
            "kind": "write",
            "bytes": [
              "0x00",
              "0x0C"
            ],
            "pointer_target": "CRA_REG_M"
          },
          "notes": "Set TEMP_EN=1, DO=100 (15Hz) => 0x0C"
        },
        {
          "op": "write",
          "transaction": {
            "kind": "write",
            "bytes": [
              "0x01",
              "0x20"
            ],
            "pointer_target": "CRB_REG_M"
          },
          "notes": "Set GN=001 (±1.3 gauss) => 0x20"
        },
        {
          "op": "write",
          "transaction": {
            "kind": "write",
            "bytes": [
              "0x02",
              "0x00"
            ],
            "pointer_target": "MR_REG_M"
          },
          "notes": "Set continuous-conversion mode (MD=00) => 0x00"
        },
        {
          "op": "delay",
          "delay_ms": 1,
          "notes": "Wait for magnetometer turn-on time: typical 1 ms after mode change (timing_constraints)."
        }
      ],
      "outputs": [
        {
          "channel": "mag_x",
          "byte_source": "OUT_X_H_M:8 || OUT_X_L_M:8",
          "formula_id": "mag_from_raw"
        },
        {
          "channel": "mag_y",
          "byte_source": "OUT_Y_H_M:8 || OUT_Y_L_M:8",
          "formula_id": "mag_from_raw"
        },
        {
          "channel": "mag_z",
          "byte_source": "OUT_Z_H_M:8 || OUT_Z_L_M:8",
          "formula_id": "mag_from_raw"
        },
        {
          "channel": "temperature",
          "byte_source": "TEMP_OUT_H_M:8 || TEMP_OUT_L_M:8",
          "formula_id": "temp_from_raw"
        }
      ],
      "notes": "Initializes magnetometer in continuous-conversion mode, 15Hz ODR, ±1.3 gauss range, temperature sensor enabled."
    },
    {
      "flow_id": "read_accel",
      "kind": "read",
      "channels": [
        "accel_x",
        "accel_y",
        "accel_z"
      ],
      "preconditions": [
        "init_accel completed"
      ],
      "steps": [
        {
          "op": "poll_until",
          "register": "STATUS_REG_A",
          "mask": "0x08",
          "value": "0x08",
          "timeout_ms": 100,
          "interval_ms": 1,
          "notes": "Poll STATUS_REG_A ZYXDA bit (bit 3) until new data available."
        },
        {
          "op": "write_then_read",
          "transaction": {
            "kind": "write_then_read",
            "bytes": [
              "0xA8"
            ],
            "length": 6,
            "pointer_target": "OUT_X_L_A"
          },
          "notes": "Set auto-increment address to OUT_X_L_A (0x28) with MSB=1, read 6 bytes: X_L, X_H, Y_L, Y_H, Z_L, Z_H."
        }
      ],
      "outputs": [
        {
          "channel": "accel_x",
          "byte_source": "byte1:8 || byte0:8",
          "formula_id": "accel_from_raw"
        },
        {
          "channel": "accel_y",
          "byte_source": "byte3:8 || byte2:8",
          "formula_id": "accel_from_raw"
        },
        {
          "channel": "accel_z",
          "byte_source": "byte5:8 || byte4:8",
          "formula_id": "accel_from_raw"
        }
      ],
      "notes": "Reads all three acceleration axes in one burst using auto-increment, after polling for data ready."
    },
    {
      "flow_id": "read_mag",
      "kind": "read",
      "channels": [
        "mag_x",
        "mag_y",
        "mag_z",
        "temperature"
      ],
      "preconditions": [
        "init_mag completed"
      ],
      "steps": [
        {
          "op": "poll_until",
          "register": "SR_REG_Mg",
          "mask": "0x01",
          "value": "0x01",
          "timeout_ms": 200,
          "interval_ms": 1,
          "notes": "Poll SR_REG_M DRDY bit (bit 0) until new data available."
        },
        {
          "op": "write_then_read",
          "transaction": {
            "kind": "write_then_read",
            "bytes": [
              "0x03"
            ],
            "length": 6,
            "pointer_target": "OUT_X_H_M"
          },
          "notes": "Set address to OUT_X_H_M (0x03), read 6 bytes: X_H, X_L, Z_H, Z_L, Y_H, Y_L."
        },
        {
          "op": "write_then_read",
          "transaction": {
            "kind": "write_then_read",
            "bytes": [
              "0x31"
            ],
            "length": 2,
            "pointer_target": "TEMP_OUT_H_M"
          },
          "notes": "Read temperature: TEMP_OUT_H_M (0x31) and TEMP_OUT_L_M (0x32)."
        }
      ],
      "outputs": [
        {
          "channel": "mag_x",
          "byte_source": "byte0:8 || byte1:8",
          "formula_id": "mag_from_raw"
        },
        {
          "channel": "mag_z",
          "byte_source": "byte2:8 || byte3:8",
          "formula_id": "mag_from_raw"
        },
        {
          "channel": "mag_y",
          "byte_source": "byte4:8 || byte5:8",
          "formula_id": "mag_from_raw"
        },
        {
          "channel": "temperature",
          "byte_source": "byte0:8 || byte1:8",
          "formula_id": "temp_from_raw"
        }
      ],
      "notes": "Reads magnetometer axes and temperature after polling for data ready. Note: magnetometer output registers are in order X_H, X_L, Z_H, Z_L, Y_H, Y_L."
    }
  ],
  "raw_encoding": {
    "byte_order": "big_endian",
    "bit_width": 16,
    "effective_bits": 16,
    "signed": true,
    "right_shift": null,
    "sign_extend_from_bit": null,
    "notes": "Accelerometer and magnetometer data are 16-bit two's complement, MSB first."
  },
  "registers_or_commands": [
    {
      "name": "CTRL_REG1_A",
      "value": "0x20",
      "access": "rw",
      "size_bits": 8,
      "description": "Accelerometer control register 1: ODR, LPen, axis enables"
    },
    {
      "name": "CTRL_REG2_A",
      "value": "0x21",
      "access": "rw",
      "size_bits": 8,
      "description": "Accelerometer control register 2: high-pass filter"
    },
    {
      "name": "CTRL_REG3_A",
      "value": "0x22",
      "access": "rw",
      "size_bits": 8,
      "description": "Accelerometer control register 3: interrupt enables"
    },
    {
      "name": "CTRL_REG4_A",
      "value": "0x23",
      "access": "rw",
      "size_bits": 8,
      "description": "Accelerometer control register 4: BDU, BLE, FS, HR, SIM"
    },
    {
      "name": "CTRL_REG5_A",
      "value": "0x24",
      "access": "rw",
      "size_bits": 8,
      "description": "Accelerometer control register 5: BOOT, FIFO, latch"
    },
    {
      "name": "CTRL_REG6_A",
      "value": "0x25",
      "access": "rw",
      "size_bits": 8,
      "description": "Accelerometer control register 6: interrupt pad mapping"
    },
    {
      "name": "REFERENCE_A",
      "value": "0x26",
      "access": "rw",
      "size_bits": 8,
      "description": "Reference value for interrupt generation"
    },
    {
      "name": "STATUS_REG_A",
      "value": "0x27",
      "access": "ro",
      "size_bits": 8,
      "description": "Accelerometer status: overrun and data available"
    },
    {
      "name": "OUT_X_L_A",
      "value": "0x28",
      "access": "ro",
      "size_bits": 8,
      "description": "X-axis acceleration low byte"
    },
    {
      "name": "OUT_X_H_A",
      "value": "0x29",
      "access": "ro",
      "size_bits": 8,
      "description": "X-axis acceleration high byte"
    },
    {
      "name": "OUT_Y_L_A",
      "value": "0x2A",
      "access": "ro",
      "size_bits": 8,
      "description": "Y-axis acceleration low byte"
    },
    {
      "name": "OUT_Y_H_A",
      "value": "0x2B",
      "access": "ro",
      "size_bits": 8,
      "description": "Y-axis acceleration high byte"
    },
    {
      "name": "OUT_Z_L_A",
      "value": "0x2C",
      "access": "ro",
      "size_bits": 8,
      "description": "Z-axis acceleration low byte"
    },
    {
      "name": "OUT_Z_H_A",
      "value": "0x2D",
      "access": "ro",
      "size_bits": 8,
      "description": "Z-axis acceleration high byte"
    },
    {
      "name": "FIFO_CTRL_REG_A",
      "value": "0x2E",
      "access": "rw",
      "size_bits": 8,
      "description": "FIFO control: mode, trigger, threshold"
    },
    {
      "name": "FIFO_SRC_REG_A",
      "value": "0x2F",
      "access": "ro",
