  ],
  "bitfields": [
    {
      "register": "CTRL_REG1_A",
      "name": "ODR3-0",
      "bits": "7:4",
      "description": "Data rate selection. Default: 0000 (power-down)."
    },
    {
      "register": "CTRL_REG1_A",
      "name": "LPen",
      "bits": "3",
      "description": "Low-power mode enable. Default: 0."
    },
    {
      "register": "CTRL_REG1_A",
      "name": "Zen",
      "bits": "2",
      "description": "Z axis enable. Default: 1."
    },
    {
      "register": "CTRL_REG1_A",
      "name": "Yen",
      "bits": "1",
      "description": "Y axis enable. Default: 1."
    },
    {
      "register": "CTRL_REG1_A",
      "name": "Xen",
      "bits": "0",
      "description": "X axis enable. Default: 1."
    },
    {
      "register": "CTRL_REG4_A",
      "name": "BDU",
      "bits": "7",
      "description": "Block data update. Default: 0."
    },
    {
      "register": "CTRL_REG4_A",
      "name": "BLE",
      "bits": "6",
      "description": "Big/little endian. Default: 0."
    },
    {
      "register": "CTRL_REG4_A",
      "name": "FS1-0",
      "bits": "5:4",
      "description": "Full-scale selection. Default: 00 (±2g)."
    },
    {
      "register": "CTRL_REG4_A",
      "name": "HR",
      "bits": "3",
      "description": "High resolution enable. Default: 0."
    },
    {
      "register": "CTRL_REG4_A",
      "name": "SIM",
      "bits": "0",
      "description": "SPI mode. Default: 0."
    },
    {
      "register": "CRA_REG_M",
      "name": "TEMP_EN",
      "bits": "7",
      "description": "Temperature sensor enable. Default: 0."
    },
    {
      "register": "CRA_REG_M",
      "name": "DO2-0",
      "bits": "4:2",
      "description": "Data output rate. Default: 100 (15Hz)."
    },
    {
      "register": "CRB_REG_M",
      "name": "GN2-0",
      "bits": "7:5",
      "description": "Gain configuration. Default: 001 (±1.3 gauss)."
    },
    {
      "register": "MR_REG_M",
      "name": "MD1-0",
      "bits": "1:0",
      "description": "Mode select. Default: 11 (sleep)."
    }
  ],
  "init_sequence": [
    {
      "transaction": null,
      "notes": "Power-up: wait for supply stabilization (no explicit timing given)."
    },
    {
      "transaction": {
        "kind": "write",
        "bytes": [
          "0x20",
          "0x57"
        ],
        "pointer_target": "CTRL_REG1_A"
      },
      "notes": "Accelerometer: ODR=100Hz, normal mode, all axes enabled."
    },
    {
      "transaction": {
        "kind": "write",
        "bytes": [
          "0x23",
          "0x08"
        ],
        "pointer_target": "CTRL_REG4_A"
      },
      "notes": "Accelerometer: ±2g, high resolution enabled."
    },
