{
  "eval_class": "multi_channel",
  "init_call": "dps310_init(&g_eval_dev, bus_handle)",
  "channels": [
    {
      "id": "pressure",
      "call": "dps310_read_pressure(&g_eval_dev, &pressure_raw)",
      "out_arg": "pressure_raw",
      "out_type": "int32_t",
      "physical_unit": "raw_count"
    },
    {
      "id": "temp",
      "call": "dps310_read_temp(&g_eval_dev, &temp_raw)",
      "out_arg": "temp_raw",
      "out_type": "int32_t",
      "physical_unit": "raw_count"
    }
  ],
  "dev_struct_type": "struct dps310_dev",
  "init_extra_setup_c": "DevHandle bus_handle = I2cOpen(1);\nif (bus_handle == NULL) { return DRIVERGEN_EVAL_ERR_INVALID; }"
}
