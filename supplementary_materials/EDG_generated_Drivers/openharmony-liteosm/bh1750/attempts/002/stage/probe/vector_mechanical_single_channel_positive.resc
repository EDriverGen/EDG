:name: bh1750_eval
:description: I2C vector test for bh1750

$bin = @<RUN_DIR>/attempts/002/stage/out/bh1750_openharmony-liteosm.elf

mach create "bh1750_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/002/stage/probe/platform_mechanical_single_channel_positive.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
