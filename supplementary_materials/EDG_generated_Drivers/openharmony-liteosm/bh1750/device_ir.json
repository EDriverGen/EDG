          },
          {
            "name": "X",
            "byte_source": null,
            "source_signal": null,
            "default_value": 69,
            "config_source": "MTreg",
            "description": "MTreg value (default 69)."
          }
        ],
        "output": {
          "name": "illuminance_millilux",
          "unit": "millilux"
        }
      }
    },
    {
      "name": "illuminance_hres2",
      "formula": "Illuminance (lux) = raw_count / (1.2 * (69 / X) * 2) where X is MTreg value (default 69).",
      "integer_approximation_expression": {
        "expression": "(raw_count * 1000) // (240 * 69 // X)",
