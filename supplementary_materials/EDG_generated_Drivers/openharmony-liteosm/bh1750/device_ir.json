  "conversion_formulae": [
    {
      "name": "illuminance_hres",
      "formula": "Illuminance (lux) = raw_count / (1.2 * (69 / X)) where X is MTreg value (default 69).",
      "integer_approximation_expression": {
        "expression": "(raw_count * 1000) // (120 * 69 // X)",
        "inputs": [
          {
            "name": "raw_count",
