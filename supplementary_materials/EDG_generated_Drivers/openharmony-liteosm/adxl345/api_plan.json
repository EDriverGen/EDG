{
  "eval_class": "multi_channel",
  "init_call": "adxl345_init(&g_eval_dev, bus_handle)",
  "channels": [
    {
      "id": "accel_x",
      "call": "adxl345_read_xyz(&g_eval_dev, &ax, &ay, &az)",
      "out_arg": "ax",
      "out_type": "int16_t",
      "physical_unit": "raw_count"
    },
    {
      "id": "accel_y",
      "call": "adxl345_read_xyz(&g_eval_dev, &ax, &ay, &az)",
      "out_arg": "ay",
      "out_type": "int16_t",
      "physical_unit": "raw_count"
    },
    {
      "id": "accel_z",
      "call": "adxl345_read_xyz(&g_eval_dev, &ax, &ay, &az)",
      "out_arg": "az",
      "out_type": "int16_t",
      "physical_unit": "raw_count"
    }
  ],
  "dev_struct_type": "struct adxl345_dev",
  "init_extra_setup_c": "DevHandle bus_handle = SpiOpen(&(struct SpiDevInfo){ .busNum = 0, .csNum = 0 });\nif (bus_handle == NULL) { return DRIVERGEN_EVAL_ERR_IO; }",
  "preamble_c": "#include \"spi_if.h\"\n#include \"hdf_base.h\""
}
