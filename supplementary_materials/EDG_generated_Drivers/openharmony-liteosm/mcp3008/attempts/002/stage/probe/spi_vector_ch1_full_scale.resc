:name: mcp3008_eval
:description: SPI vector test for mcp3008

$bin = @<RUN_DIR>/attempts/002/stage/out/mcp3008_openharmony-liteosm.elf

mach create "mcp3008_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/002/stage/probe/spi_platform_ch1_full_scale.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
