{
  "eval_class": "multi_channel",
  "init_call": "bme280_init(&g_eval_dev, bus_handle)",
  "channels": [
    {
      "id": "temp",
      "call": "bme280_read_all(&g_eval_dev, &temp_raw, &pressure_raw, &humidity_raw)",
      "out_arg": "temp_raw",
      "out_type": "int32_t",
      "physical_unit": "raw_count"
    },
    {
      "id": "pressure",
      "call": "bme280_read_all(&g_eval_dev, &temp_raw, &pressure_raw, &humidity_raw)",
      "out_arg": "pressure_raw",
      "out_type": "int32_t",
      "physical_unit": "raw_count"
    },
    {
      "id": "humidity",
      "call": "bme280_read_all(&g_eval_dev, &temp_raw, &pressure_raw, &humidity_raw)",
      "out_arg": "humidity_raw",
      "out_type": "int32_t",
      "physical_unit": "raw_count"
    }
  ],
  "dev_struct_type": "struct bme280_dev",
  "init_extra_setup_c": "DevHandle bus_handle = I2cOpen(1);\nif (bus_handle == NULL) { return DRIVERGEN_EVAL_ERR_INVALID; }",
  "preamble_c": "#include \"i2c_if.h\"\n#include \"i2c_msg.h\"\n#include \"hdf_base.h\"\n#include \"los_tick.h\"\n#include \"osal_mem.h\"\n#include \"osal_mutex.h\"\n#include \"osal_time.h\"\n#include <stdint.h>"
}
