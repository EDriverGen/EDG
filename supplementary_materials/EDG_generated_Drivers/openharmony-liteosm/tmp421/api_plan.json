{
  "eval_class": "multi_channel",
  "init_call": "tmp421_init(&g_eval_dev, bus_handle)",
  "init_extra_setup_c": "DevHandle bus_handle = I2cOpen(1);\nif (bus_handle == NULL) { return DRIVERGEN_EVAL_ERR_INVALID; }",
  "dev_struct_type": "struct tmp421_device",
  "channels": [
    {
      "id": "temp_local",
      "call": "tmp421_read_temp_local(&g_eval_dev, &temp_local)",
      "out_arg": "temp_local",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    },
    {
      "id": "temp_remote",
      "call": "tmp421_read_temp_remote(&g_eval_dev, &temp_remote)",
      "out_arg": "temp_remote",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    }
  ]
}
