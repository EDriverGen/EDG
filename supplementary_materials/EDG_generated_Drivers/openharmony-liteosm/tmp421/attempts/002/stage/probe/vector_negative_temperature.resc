:name: tmp421_eval
:description: I2C vector test for tmp421

$bin = @<RUN_DIR>/attempts/002/stage/out/tmp421_openharmony-liteosm.elf

mach create "tmp421_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/002/stage/probe/platform_negative_temperature.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
