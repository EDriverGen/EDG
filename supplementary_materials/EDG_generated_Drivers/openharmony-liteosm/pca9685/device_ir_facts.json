  "evidence_spans": [
    {
      "source_id": "pca9685",
      "page": 7,
      "snippet": "The last bit of the address byte defines the operation to be performed. When set to logic 1 a read is selected, while a logic 0 selects a write operation."
    },
    {
      "source_id": "pca9685",
      "page": 8,
      "snippet": "Default power-up value (ALLCALLADR register): E0h or 1110 000X"
    },
    {
      "source_id": "pca9685",
      "page": 8,
      "snippet": "Default power-up values: -SUBADR1 register: E2h or 1110 001X"
    },
    {
      "source_id": "pca9685",
      "page": 8,
      "snippet": "PCA9685 sends an ACK when E0h (R/W = 0) or E1h (R/W = 1) is sent by the master."
    },
    {
      "source_id": "pca9685",
      "page": 14,
      "snippet": "Mode register 1 controlling restart, external clock, auto-increment, sleep, subaddress and all-call response"
    },
    {
      "source_id": "pca9685",
      "page": 16,
      "snippet": "Outputs change on STOP command [2]."
    },
    {
      "source_id": "pca9685",
      "page": 21,
      "snippet": "LEDn_ON count for LED0, 8 LSBs"
    },
    {
      "source_id": "pca9685",
      "page": 25,
      "snippet": "The LEDn_ON and LEDn_OFF counts can vary from 0 to 4095."
    },
    {
      "source_id": "pca9685",
      "page": 25,
      "snippet": "The hardware forces a minimum value that can be loaded into the PRE_SCALE register at '3'."
    },
    {
      "source_id": "pca9685",
      "page": 15,
      "snippet": "It takes 500  s max. for the oscillator to be up and running once SLEEP bit has been set to logic 0."
    },
    {
      "source_id": "pca9685",
      "page": 28,
      "snippet": "Once the correct byte (SWRST data byte 1) has been sent and correctly acknowledged, the master sends a STOP command to end the SWRST Call"
    },
    {
      "source_id": "pca9685",
      "page": 40,
      "snippet": "Minimum SCL clock frequency is limited by the bus time-out feature, which resets the serial bus interface if either SDA or SCL is held LOW for a minimum of 25 ms."
    }
  ],
