{
  "eval_class": "multi_channel",
  "init_call": "lsm303dlhc_init(&g_eval_dev, bus_handle)",
  "channels": [
    {
      "id": "accel_x",
      "call": "lsm303dlhc_read_accel(&g_eval_dev, &ax, &ay, &az)",
      "out_arg": "ax",
      "out_type": "int32_t",
      "physical_unit": "milli_g"
    },
    {
      "id": "accel_y",
      "call": "lsm303dlhc_read_accel(&g_eval_dev, &ax, &ay, &az)",
      "out_arg": "ay",
      "out_type": "int32_t",
      "physical_unit": "milli_g"
    },
    {
      "id": "accel_z",
      "call": "lsm303dlhc_read_accel(&g_eval_dev, &ax, &ay, &az)",
      "out_arg": "az",
      "out_type": "int32_t",
      "physical_unit": "milli_g"
    },
    {
      "id": "mag_x",
      "call": "lsm303dlhc_read_mag(&g_eval_dev, &mx, &my, &mz)",
      "out_arg": "mx",
      "out_type": "int32_t",
      "physical_unit": "milli_gauss"
    },
    {
      "id": "mag_y",
      "call": "lsm303dlhc_read_mag(&g_eval_dev, &mx, &my, &mz)",
      "out_arg": "my",
      "out_type": "int32_t",
      "physical_unit": "milli_gauss"
    },
    {
      "id": "mag_z",
      "call": "lsm303dlhc_read_mag(&g_eval_dev, &mx, &my, &mz)",
      "out_arg": "mz",
      "out_type": "int32_t",
      "physical_unit": "milli_gauss"
    },
    {
      "id": "temp",
      "call": "lsm303dlhc_read_temp(&g_eval_dev, &t)",
      "out_arg": "t",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    }
  ],
  "dev_struct_type": "struct lsm303dlhc_dev",
  "init_extra_setup_c": "DevHandle bus_handle = I2cOpen(1);\nif (bus_handle == NULL) { return DRIVERGEN_EVAL_ERR_INVALID; }"
}
