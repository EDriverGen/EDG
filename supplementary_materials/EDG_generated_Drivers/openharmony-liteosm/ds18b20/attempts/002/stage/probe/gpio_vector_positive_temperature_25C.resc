:name: ds18b20_eval
:description: GPIO pulse-timing vector test for ds18b20

$bin = @<RUN_DIR>/attempts/002/stage/out/ds18b20_openharmony-liteosm.elf

mach create "ds18b20_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/002/stage/probe/gpio_platform_positive_temperature_25C.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
