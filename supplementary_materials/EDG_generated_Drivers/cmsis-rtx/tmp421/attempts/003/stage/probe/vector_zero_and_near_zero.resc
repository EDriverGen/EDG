:name: tmp421_eval
:description: I2C vector test for tmp421

$bin = @<RUN_DIR>/attempts/003/stage/out/tmp421_cmsis-rtx.elf

mach create "tmp421_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/003/stage/probe/platform_zero_and_near_zero.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
