:name: ds3231_eval
:description: I2C vector test for ds3231

$bin = @<RUN_DIR>/attempts/001/stage/out/ds3231_cmsis-rtx.elf

mach create "ds3231_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/001/stage/probe/platform_nominal_time.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
