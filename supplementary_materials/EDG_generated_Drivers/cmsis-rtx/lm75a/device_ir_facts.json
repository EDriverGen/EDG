  "evidence_spans": [
    {
      "source_id": "lm75a",
      "page": 8,
      "snippet": "These pins represent the three LSB bits of the device 7-bit address. The other four MSB bits of the address data are preset to '1001'"
    },
    {
      "source_id": "lm75a",
      "page": 8,
      "snippet": "At power-up, the Pointer value is equal to 0 and the Temp register is selected"
    },
    {
      "source_id": "lm75a",
      "page": 9,
      "snippet": "only 11 significant bits should be used, and the 5 LSB bits of the LS byte are zero and should be ignored."
    },
    {
      "source_id": "lm75a",
      "page": 10,
      "snippet": "However, only 9 bits of the two bytes are used to store the set-point data in 2's complement format with the resolution of 0.5 ° C."
    },
