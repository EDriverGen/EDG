:name: lm75a_eval
:description: I2C vector test for lm75a

$bin = @<RUN_DIR>/attempts/001/stage/out/lm75a_cmsis-rtx.elf

mach create "lm75a_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/001/stage/probe/platform_mechanical_single_channel_positive.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
