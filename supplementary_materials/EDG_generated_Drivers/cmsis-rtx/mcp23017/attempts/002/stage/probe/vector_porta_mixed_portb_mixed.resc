:name: mcp23017_eval
:description: I2C vector test for mcp23017

$bin = @<RUN_DIR>/attempts/002/stage/out/mcp23017_cmsis-rtx.elf

mach create "mcp23017_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/002/stage/probe/platform_porta_mixed_portb_mixed.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
