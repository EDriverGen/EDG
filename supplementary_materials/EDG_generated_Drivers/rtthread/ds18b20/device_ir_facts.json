  "evidence_spans": [
    {
      "source_id": "ds18b20",
      "page": 3,
      "snippet": "The DS18B20 output temperature data is calibrated in degrees Celsius; for Fahrenheit applications, a lookup table or conversion routine must be used."
    },
    {
      "source_id": "ds18b20",
      "page": 3,
      "snippet": "The temperature data is stored as a 16-bit sign-extended two's complement number in the temperature register"
    },
    {
      "source_id": "ds18b20",
      "page": 8,
      "snippet": "Byte 4 of the scratchpad memory contains the configuration register"
    },
    {
      "source_id": "ds18b20",
      "page": 8,
      "snippet": "The user can set the conversion resolution of the DS18B20 using the R0 and R1 bits in this register as shown in Table 2."
    },
    {
      "source_id": "ds18b20",
      "page": 11,
      "snippet": "This command initiates a single temperature conversion."
    },
    {
      "source_id": "ds18b20",
      "page": 11,
      "snippet": "This command allows the master to read the contents of the scratchpad."
    },
    {
      "source_id": "ds18b20",
      "page": 15,
      "snippet": "All communication with the DS18B20 begins with an initialization sequence that consists of a reset pulse from the master followed by a presence pulse from the DS18B20."
    },
    {
      "source_id": "ds18b20",
      "page": 20,
      "snippet": "Temperature Conversion Time: 9-bit resolution: 93.75 ms, 10-bit: 187.5 ms, 11-bit: 375 ms, 12-bit: 750 ms"
    },
    {
      "source_id": "ds18b20",
      "page": 20,
      "snippet": "Time Slot: 60 to 120 µs"
    }
  ],
