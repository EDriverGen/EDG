:name: ds3231_eval
:description: I2C vector test for ds3231

$bin = @<RUN_DIR>/attempts/002/stage/out/ds3231_rtthread.elf

mach create "ds3231_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/002/stage/probe/platform_read_time_2024_03_15_12_30_45_3.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
