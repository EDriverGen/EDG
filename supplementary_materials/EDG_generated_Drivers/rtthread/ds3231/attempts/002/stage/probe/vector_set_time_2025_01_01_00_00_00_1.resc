:name: ds3231_eval
:description: I2C vector test for ds3231

$bin = @<RUN_DIR>/attempts/002/stage/out/ds3231_rtthread.elf

mach create "ds3231_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/002/stage/probe/platform_set_time_2025_01_01_00_00_00_1.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
