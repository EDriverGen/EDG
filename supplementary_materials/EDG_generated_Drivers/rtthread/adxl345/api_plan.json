{
  "eval_class": "multi_channel",
  "init_call": "adxl345_init(&g_eval_dev, spi)",
  "channels": [
    {
      "id": "accel_x",
      "call": "adxl345_read_accel_x(&g_eval_dev, &ax)",
      "out_arg": "ax",
      "out_type": "int32_t",
      "physical_unit": "raw_count"
    },
    {
      "id": "accel_y",
      "call": "adxl345_read_accel_y(&g_eval_dev, &ay)",
      "out_arg": "ay",
      "out_type": "int32_t",
      "physical_unit": "raw_count"
    },
    {
      "id": "accel_z",
      "call": "adxl345_read_accel_z(&g_eval_dev, &az)",
      "out_arg": "az",
      "out_type": "int32_t",
      "physical_unit": "raw_count"
    }
  ],
  "dev_struct_type": "struct adxl345_device",
  "init_extra_setup_c": "struct rt_spi_device *spi = (struct rt_spi_device *)rt_device_find(bus_name);\nif (spi == RT_NULL) { return DRIVERGEN_EVAL_ERR_INVALID; }"
}
