  "evidence_spans": [
    {
      "source_id": "lm75a",
      "page": 8,
      "snippet": "the other four MSB bits of the address data are preset to '1001'"
    },
    {
      "source_id": "lm75a",
      "page": 9,
      "snippet": "only 11 significant bits should be used, and the 5 LSB bits of the LS byte are zero and should be ignored."
    },
    {
      "source_id": "lm75a",
      "page": 7,
      "snippet": "the temp-to-digital conversion is executed every 100 ms"
    },
    {
      "source_id": "lm75a",
      "page": 8,
      "snippet": "At power-up, the Pointer value is equal to 0 and the Temp register is selected"
    },
    {
      "source_id": "lm75a",
      "page": 9,
      "snippet": "If the Temp data MSB bit D10 = 0 then the temperature is positive and Temp value (°C) = + (Temp data) * 0.125 °C"
    },
    {
      "source_id": "lm75a",
      "page": 9,
      "snippet": "If the Temp data MSB bit D10 = 1 then the temperature is negative and Temp value (°C) = - (2's complement of Temp data) * 0.125 °C"
    },
    {
      "source_id": "lm75a",
      "page": 10,
      "snippet": "only 9 significant bits should be used and the 7 LSB bits of the LS byte are equal to zero and should be ignored."
    },
    {
      "source_id": "lm75a",
      "page": 11,
      "snippet": "At power-up, the device is put into normal operation mode, the Tos is set to 80 °C, the Thyst is set to 75 °C"
    },
    {
      "source_id": "lm75a",
      "page": 6,
      "snippet": "SCL clock period 2.5 µs"
    },
    {
      "source_id": "lm75a",
      "page": 6,
      "snippet": "SCL HIGH pulse width 0.6 µs"
    },
    {
      "source_id": "lm75a",
      "page": 6,
      "snippet": "SCL LOW pulse width 1.3 µs"
    },
    {
      "source_id": "lm75a",
      "page": 6,
      "snippet": "Start Hold time 100 ns"
    },
    {
      "source_id": "lm75a",
      "page": 6,
      "snippet": "Data set-up time 100 ns"
    },
    {
      "source_id": "lm75a",
      "page": 6,
      "snippet": "Data hold time 0 ns"
    },
    {
      "source_id": "lm75a",
      "page": 6,
      "snippet": "Stop set-up time 100 ns"
    },
    {
      "source_id": "lm75a",
      "page": 9,
      "snippet": "Configuration Register. Contains a single 8-bit data byte."
    },
    {
      "source_id": "lm75a",
      "page": 9,
      "snippet": "Temperature Register. Contains two 8-bit data bytes."
    },
    {
      "source_id": "lm75a",
      "page": 10,
      "snippet": "Over-temp Shutdown threshold Register. Contains two 8-bit data bytes."
    },
    {
      "source_id": "lm75a",
      "page": 10,
      "snippet": "Hysteresis Register. Contains two 8-bit data bytes."
    },
    {
      "source_id": "lm75a",
      "page": 8,
      "snippet": "the three LSB bits of the device 7-bit address"
    },
    {
      "source_id": "lm75a",
      "page": 8,
      "snippet": "the input pins, SCL, SDA, A2-A0, are not internally biased"
    },
    {
      "source_id": "lm75a",
      "page": 11,
      "snippet": "OS output is an open-drain output"
    },
    {
      "source_id": "lm75a",
      "page": 11,
      "snippet": "Tos & Thyst limits must be selected so that Tos temp value > Thyst temp value"
    },
    {
      "source_id": "lm75a",
      "page": 11,
      "snippet": "Fault queue is defined as the number of faults that must occur consecutively"
    },
    {
      "source_id": "lm75a",
      "page": 11,
      "snippet": "When the power supply voltage is dropped below the device power-on reset level of about 1.9 V"
    },
    {
      "source_id": "lm75a",
      "page": 5,
      "snippet": "Temperature accuracy ±2 °C from -25 °C to +100 °C"
    },
    {
      "source_id": "lm75a",
      "page": 5,
      "snippet": "Temperature resolution 0.125 °C"
    },
    {
      "source_id": "lm75a",
      "page": 5,
      "snippet": "Supply quiescent current Normal mode: I2C inactive 100 µA"
    },
    {
      "source_id": "lm75a",
      "page": 5,
      "snippet": "Supply quiescent current Shut-down mode 3.5 µA"
    },
    {
      "source_id": "lm75a",
      "page": 2,
      "snippet": "Pin-for-pin replacement for industry standard LM75"
    }
