:name: tmp421_eval
:description: I2C vector test for tmp421

$bin = @<RUN_DIR>/attempts/001/stage/out/tmp421_rtthread.elf

mach create "tmp421_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/001/stage/probe/platform_remote_positive_temp.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
