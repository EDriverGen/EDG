{
  "eval_class": "multi_channel",
  "init_call": "tmp421_init(&g_eval_dev, bus);",
  "init_extra_setup_c": "struct rt_i2c_bus_device *bus = rt_i2c_bus_device_find(bus_name);\nif (bus == RT_NULL) { return DRIVERGEN_EVAL_ERR_INVALID; }",
  "dev_struct_type": "struct tmp421_device",
  "channels": [
    {
      "id": "temp_local",
      "call": "tmp421_read_local(&g_eval_dev, &temp_local_val);",
      "out_arg": "temp_local_val",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    },
    {
      "id": "temp_remote",
      "call": "tmp421_read_remote(&g_eval_dev, &temp_remote_val);",
      "out_arg": "temp_remote_val",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    }
  ]
}
