  "conversion_formulae": [
    {
      "name": "accel_from_raw",
      "formula": "Acceleration (g) = raw * full_scale_range / 32768, where full_scale_range depends on AFS_SEL: ±2g (16384 LSB/g), ±4g (8192 LSB/g), ±8g (4096 LSB/g), ±16g (2048 LSB/g).",
      "integer_approximation_expression": {
        "expression": "(raw * 1000) // 16384",
        "inputs": [
          {
            "name": "raw",
            "byte_source": "ACCEL_XOUT_H:8 || ACCEL_XOUT_L:8",
            "description": "16-bit two's complement accelerometer reading."
          }
        ],
        "output": {
          "name": "accel_milli_g",
          "unit": "g"
        }
      }
    },
    {
      "name": "temperature_from_raw",
      "formula": "Temperature (degC) = (TEMP_OUT / 340) + 36.53",
      "integer_approximation_expression": {
        "expression": "((raw * 1000) // 340) + 36530",
        "inputs": [
          {
            "name": "raw",
            "byte_source": "TEMP_OUT_H:8 || TEMP_OUT_L:8",
            "description": "16-bit signed temperature reading."
          }
        ],
        "output": {
          "name": "temp_milli_degC",
          "unit": "milli_degC"
        }
      }
    },
    {
      "name": "gyro_from_raw",
      "formula": "Angular rate (deg/s) = raw / sensitivity, where sensitivity depends on FS_SEL: ±250°/s (131 LSB/°/s), ±500°/s (65.5 LSB/°/s), ±1000°/s (32.8 LSB/°/s), ±2000°/s (16.4 LSB/°/s).",
      "integer_approximation_expression": {
        "expression": "(raw * 1000) // 131",
        "inputs": [
          {
            "name": "raw",
            "byte_source": "GYRO_XOUT_H:8 || GYRO_XOUT_L:8",
            "description": "16-bit two's complement gyroscope reading."
          }
        ],
        "output": {
          "name": "gyro_milli_deg_per_s",
          "unit": "deg_per_s"
        }
      }
    }
  ],
