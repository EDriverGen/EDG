        "GYRO_ZOUT_L"
      ],
      "formula_id": "gyro_from_raw"
    }
  ],
  "access_model": {
    "kind": "register_pointer",
    "address_bytes": 1,
    "read_requires_pointer": true,
    "direct_read_after_write": false,
    "notes": "Register pointer is written first, then data is read/written."
  },
  "operation_flows": [
    {
      "flow_id": "init",
      "kind": "init",
      "channels": [],
      "preconditions": [
        "Device powered on"
      ],
      "steps": [
        {
          "op": "write",
          "transaction": {
            "kind": "write",
            "bytes": [
              "0x6B",
              "0x00"
            ]
          },
          "notes": "Wake up device: clear SLEEP bit in PWR_MGMT_1."
        },
        {
          "op": "delay",
          "delay_ms": 100,
          "notes": "Wait for device to stabilize after wake-up."
        }
      ],
      "outputs": [],
      "requires_human": true,
      "notes": "The exact power-up stabilization time is not specified; 100 ms is a typical assumption. Clock source configuration (CLKSEL) is recommended but not implemented; defaults to internal oscillator."
    },
    {
      "flow_id": "probe",
      "kind": "probe",
      "channels": [],
      "preconditions": [
        "Device initialized"
      ],
      "steps": [
        {
          "op": "write_then_read",
          "transaction": {
            "kind": "write_then_read",
            "bytes": [
              "0x75"
            ],
            "length": 1,
            "pointer_target": "WHO_AM_I"
          },
          "notes": "Read WHO_AM_I register to verify device identity."
        }
      ],
      "outputs": []
    },
    {
      "flow_id": "read_sensors",
      "kind": "read",
      "channels": [
        "accel_x",
        "accel_y",
        "accel_z",
        "temperature",
        "gyro_x",
        "gyro_y",
        "gyro_z"
      ],
      "preconditions": [
        "Device initialized"
      ],
      "steps": [
        {
          "op": "write_then_read",
          "transaction": {
            "kind": "write_then_read",
            "bytes": [
              "0x3B"
            ],
            "length": 14,
            "pointer_target": "ACCEL_XOUT_H"
          },
          "notes": "Burst read from ACCEL_XOUT_H (0x3B) through GYRO_ZOUT_L (0x48), 14 bytes."
        }
      ],
      "outputs": [
        {
          "channel": "accel_x",
          "byte_source": "ACCEL_XOUT_H:8 || ACCEL_XOUT_L:8",
          "formula_id": "accel_from_raw"
        },
        {
          "channel": "accel_y",
          "byte_source": "ACCEL_YOUT_H:8 || ACCEL_YOUT_L:8",
          "formula_id": "accel_from_raw"
        },
        {
          "channel": "accel_z",
          "byte_source": "ACCEL_ZOUT_H:8 || ACCEL_ZOUT_L:8",
          "formula_id": "accel_from_raw"
        },
        {
          "channel": "temperature",
          "byte_source": "TEMP_OUT_H:8 || TEMP_OUT_L:8",
          "formula_id": "temperature_from_raw"
        },
        {
          "channel": "gyro_x",
          "byte_source": "GYRO_XOUT_H:8 || GYRO_XOUT_L:8",
          "formula_id": "gyro_from_raw"
        },
        {
          "channel": "gyro_y",
          "byte_source": "GYRO_YOUT_H:8 || GYRO_YOUT_L:8",
          "formula_id": "gyro_from_raw"
        },
        {
          "channel": "gyro_z",
          "byte_source": "GYRO_ZOUT_H:8 || GYRO_ZOUT_L:8",
          "formula_id": "gyro_from_raw"
        }
      ],
      "requires_human": true,
      "notes": "The conversion formulae assume default full-scale ranges (±2g for accel, ±250°/s for gyro). If non-default ranges are configured via GYRO_CONFIG or ACCEL_CONFIG, the formulae must be adjusted accordingly."
    }
  ],
  "raw_encoding": {
    "byte_order": "big_endian",
    "bit_width": 16,
    "effective_bits": 16,
    "signed": true,
    "right_shift": 0,
