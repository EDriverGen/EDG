{
  "eval_class": "multi_channel",
  "init_call": "sht30_init(&g_eval_dev, bus)",
  "channels": [
    {
      "id": "temperature",
      "call": "sht30_read_temperature(&g_eval_dev, &temperature_milliC)",
      "out_arg": "temperature_milliC",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    },
    {
      "id": "humidity",
      "call": "sht30_read_humidity(&g_eval_dev, &humidity_milliPercent)",
      "out_arg": "humidity_milliPercent",
      "out_type": "int32_t",
      "physical_unit": "milli_percent"
    }
  ],
  "dev_struct_type": "struct sht30_device",
  "init_extra_setup_c": "struct rt_i2c_bus_device *bus = rt_i2c_bus_device_find(bus_name);\nif (bus == RT_NULL) { return DRIVERGEN_EVAL_ERR_INVALID; }"
}
