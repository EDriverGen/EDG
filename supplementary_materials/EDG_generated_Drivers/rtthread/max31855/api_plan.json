{
  "eval_class": "multi_channel",
  "init_call": "max31855_init(&g_eval_dev, spi)",
  "channels": [
    {
      "id": "thermocouple",
      "call": "max31855_read_thermocouple(&g_eval_dev, &tc)",
      "out_arg": "tc",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    },
    {
      "id": "temp_local",
      "call": "max31855_read_internal(&g_eval_dev, &internal)",
      "out_arg": "internal",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    }
  ],
  "dev_struct_type": "struct max31855_device",
  "init_extra_setup_c": "struct rt_spi_device *spi = (struct rt_spi_device *)rt_device_find(bus_name);\nif (spi == RT_NULL) { return DRIVERGEN_EVAL_ERR_INVALID; }"
}
