    {
      "section_id": "s17",
      "heading": "Application notes:",
      "level": 1,
      "page_range": [
        7,
        7
      ],
      "table_count": 0,
      "table_headers_preview": [],
      "text_length_chars": 181,
      "content_keywords": [
        "gnd",
        "200ms",
        "arduino",
        "pcb"
      ],
      "elements": [
        {
          "type": "text",
          "content": "1: Avoid connecting this module while powered. If a powered connection is necessary, connect Gnd first."
        },
        {
          "type": "text",
          "content": "2: For irregular surfaces or distant objects, use repeated measurements for correction."
        },
        {
          "type": "text",
          "content": "3: The interval between measurements must be at least 200 mS."
        },
        {
          "type": "text",
          "content": "4: Installing the module inside a product enclosure may require adjustments to peripheral parameters;"
        },
        {
          "type": "text",
          "content": "contact the manufacturer to confirm the parameters before volume production."
        },
        {
          "type": "text",
          "content": "Application examples:"
        },
        {
