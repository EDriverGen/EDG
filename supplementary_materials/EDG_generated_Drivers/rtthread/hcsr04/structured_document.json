      "section_id": "s16",
      "heading": "Command format:",
      "level": 1,
      "page_range": [
        6,
        7
      ],
      "table_count": 1,
      "table_headers_preview": [
        "Address | Command | Return value | Description"
      ],
      "text_length_chars": 241,
      "content_keywords": [
        "byte",
        "0x01",
        "200ms",
        "1000",
        "www"
      ],
      "elements": [
        {
          "type": "table",
          "content": "| Address | Command | Return value | Description |\n|-------------|--------|----------------------|---------------------------------------------------------------------|\n| Write address 0XAE | 0X01 | | Start ranging command |\n| Read address 0XAF | | BYTE_H BYTE_M BYTE_L | Output distance: ((BYTE_H<<16)+(BYTE_M<<8)+ BYTE_L)/1000 mm |"
        },
        {
          "type": "text",
          "content": "Write 0X01 to start ranging; wait at least 200 mS (the module's maximum ranging time)."
        },
        {
          "type": "text",
          "content": "Read three distance bytes directly: BYTE_H, BYTE_M, and BYTE_L."
        },
        {
          "type": "text",
          "content": "Distance is calculated as follows (mm):"
        },
        {
          "type": "text",
          "content": "Distance=((BYTE_H<<16)+(BYTE_M<<8)+ BYTE_L)/1000"
        },
        {
          "type": "text",
          "content": "6                                                                                    WWW.WX-RCWL.COM"
        },
        {
          "type": "text",
          "content": "Wuxi Richen IoT Technology"
