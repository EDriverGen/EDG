:name: mcp3008_eval
:description: SPI vector test for mcp3008

$bin = @<RUN_DIR>/attempts/001/stage/out/mcp3008_rtthread.elf

mach create "mcp3008_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/001/stage/probe/spi_platform_ch0_full_scale.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
