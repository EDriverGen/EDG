{
  "eval_class": "multi_channel",
  "init_call": "pca9685_init(&g_eval_dev, bus)",
  "channels": [
    {
      "id": "pwm_channel_0",
      "call": "pca9685_read_pwm(&g_eval_dev, 0, &pwm0)",
      "out_arg": "pwm0",
      "out_type": "uint16_t",
      "physical_unit": "raw"
    },
    {
      "id": "pwm_channel_1",
      "call": "pca9685_read_pwm(&g_eval_dev, 1, &pwm1)",
      "out_arg": "pwm1",
      "out_type": "uint16_t",
      "physical_unit": "raw"
    }
  ],
  "dev_struct_type": "struct pca9685_device",
  "init_extra_setup_c": "struct rt_i2c_bus_device *bus = rt_i2c_bus_device_find(bus_name);\nif (bus == RT_NULL) { return DRIVERGEN_EVAL_ERR_INVALID; }"
}
