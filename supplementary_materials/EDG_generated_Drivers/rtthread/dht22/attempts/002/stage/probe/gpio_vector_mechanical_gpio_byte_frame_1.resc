:name: dht22_eval
:description: GPIO pulse-timing vector test for dht22

$bin = @<RUN_DIR>/attempts/002/stage/out/dht22_rtthread.elf

mach create "dht22_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/002/stage/probe/gpio_platform_mechanical_gpio_byte_frame_1.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
