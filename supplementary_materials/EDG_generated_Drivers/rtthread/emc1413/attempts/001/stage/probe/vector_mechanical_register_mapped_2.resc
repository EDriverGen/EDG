:name: emc1413_eval
:description: I2C vector test for emc1413

$bin = @<RUN_DIR>/attempts/001/stage/out/emc1413_rtthread.elf

mach create "emc1413_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/001/stage/probe/platform_mechanical_register_mapped_2.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
