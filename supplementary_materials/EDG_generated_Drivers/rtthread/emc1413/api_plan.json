{
  "eval_class": "multi_channel",
  "init_call": "emc1413_init(&g_eval_dev, bus)",
  "channels": [
    {
      "id": "temp_local",
      "call": "emc1413_read_internal_temp(&g_eval_dev, &temp_local_val)",
      "out_arg": "temp_local_val",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    },
    {
      "id": "temp_ext1",
      "call": "emc1413_read_external_diode_1_temp(&g_eval_dev, &temp_ext1_val)",
      "out_arg": "temp_ext1_val",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    },
    {
      "id": "temp_ext2",
      "call": "emc1413_read_external_diode_2_temp(&g_eval_dev, &temp_ext2_val)",
      "out_arg": "temp_ext2_val",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    }
  ],
  "dev_struct_type": "struct emc1413_device",
  "init_extra_setup_c": "struct rt_i2c_bus_device *bus = rt_i2c_bus_device_find(bus_name);\nif (bus == RT_NULL) { return DRIVERGEN_EVAL_ERR_INVALID; }"
}
