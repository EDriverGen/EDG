{
  "eval_class": "multi_channel",
  "init_call": "lsm303dlhc_init(&g_eval_dev, bus)",
  "init_extra_setup_c": "struct rt_i2c_bus_device *bus = rt_i2c_bus_device_find(bus_name);\nif (bus == RT_NULL) { return DRIVERGEN_EVAL_ERR_INVALID; }",
  "dev_struct_type": "lsm303dlhc_device_t",
  "channels": [
    {
      "id": "accel_x",
      "call": "lsm303dlhc_read_accel_x(&g_eval_dev, &ax)",
      "out_arg": "ax",
      "out_type": "int32_t",
      "physical_unit": "milli_g"
    },
    {
      "id": "accel_y",
      "call": "lsm303dlhc_read_accel_y(&g_eval_dev, &ay)",
      "out_arg": "ay",
      "out_type": "int32_t",
      "physical_unit": "milli_g"
    },
    {
      "id": "accel_z",
      "call": "lsm303dlhc_read_accel_z(&g_eval_dev, &az)",
      "out_arg": "az",
      "out_type": "int32_t",
      "physical_unit": "milli_g"
    },
    {
      "id": "mag_x",
      "call": "lsm303dlhc_read_mag_x(&g_eval_dev, &mx)",
      "out_arg": "mx",
      "out_type": "int32_t",
      "physical_unit": "milli_gauss"
    },
    {
      "id": "mag_y",
      "call": "lsm303dlhc_read_mag_y(&g_eval_dev, &my)",
      "out_arg": "my",
      "out_type": "int32_t",
      "physical_unit": "milli_gauss"
    },
    {
      "id": "mag_z",
      "call": "lsm303dlhc_read_mag_z(&g_eval_dev, &mz)",
      "out_arg": "mz",
      "out_type": "int32_t",
      "physical_unit": "milli_gauss"
    },
    {
      "id": "temperature",
      "call": "lsm303dlhc_read_temperature(&g_eval_dev, &temp)",
      "out_arg": "temp",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    }
  ],
  "type_normalization_note": "scaled public units use int32_t to avoid int16_t overflow"
}
