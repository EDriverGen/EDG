{
  "eval_class": "multi_channel",
  "init_call": "bme280_init(&g_eval_dev, bus)",
  "channels": [
    {
      "id": "temp",
      "call": "bme280_read_measurements(&g_eval_dev, &temp_val, &pressure_val, &humidity_val)",
      "out_arg": "temp_val",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    },
    {
      "id": "pressure",
      "call": "bme280_read_measurements(&g_eval_dev, &temp_val, &pressure_val, &humidity_val)",
      "out_arg": "pressure_val",
      "out_type": "int32_t",
      "physical_unit": "raw_count"
    },
    {
      "id": "humidity",
      "call": "bme280_read_measurements(&g_eval_dev, &temp_val, &pressure_val, &humidity_val)",
      "out_arg": "humidity_val",
      "out_type": "int32_t",
      "physical_unit": "raw_count"
    }
  ],
  "dev_struct_type": "struct bme280_dev",
  "init_extra_setup_c": "struct rt_i2c_bus_device *bus = rt_i2c_bus_device_find(bus_name);\nif (bus == RT_NULL) { return DRIVERGEN_EVAL_ERR_INVALID; }"
}
