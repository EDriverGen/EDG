:name: bme280_eval
:description: I2C vector test for bme280

$bin = @<RUN_DIR>/manual_eval_attempt004_work/build/bme280_rtthread.elf

mach create "bme280_eval"
machine LoadPlatformDescription @<RUN_DIR>/manual_eval_attempt004_work/vectors/platform_cold_dry_neg20c_1020hpa_10rh.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
