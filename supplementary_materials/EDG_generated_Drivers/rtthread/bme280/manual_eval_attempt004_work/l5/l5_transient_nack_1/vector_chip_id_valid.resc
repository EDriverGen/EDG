:name: bme280_eval
:description: I2C vector test for bme280

$bin = @<RUN_DIR>/manual_eval_attempt004_work/build/bme280_rtthread.elf

mach create "bme280_eval"
machine LoadPlatformDescription @<RUN_DIR>/manual_eval_attempt004_work/l5/l5_transient_nack_1/platform_chip_id_valid.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
