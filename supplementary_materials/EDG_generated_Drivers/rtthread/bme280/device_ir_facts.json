  "evidence_spans": [
    {
      "source_id": "bme280",
      "page": 32,
      "snippet": "The 7-bit device address is 111011x. The 6 MSB bits are fixed. The last bit is changeable by SDO value"
    },
    {
      "source_id": "bme280",
      "page": 27,
      "snippet": "The 'id' register contains the chip identification number chip_id[7:0], which is 0x60."
    },
    {
      "source_id": "bme280",
      "page": 27,
      "snippet": "If the value 0xB6 is written to the register, the device is reset using the complete power-on-reset procedure."
    },
    {
      "source_id": "bme280",
      "page": 27,
      "snippet": "The 'ctrl_hum' register sets the humidity data acquisition options of the device."
    },
    {
      "source_id": "bme280",
      "page": 28,
      "snippet": "The 'status' register contains two bits which indicate the status of the device."
    },
    {
      "source_id": "bme280",
      "page": 28,
      "snippet": "The 'ctrl_meas' register sets the pressure and temperature data acquisition options of the device."
    },
    {
      "source_id": "bme280",
      "page": 30,
      "snippet": "The 'config' register sets the rate, filter and interface options of the device."
    },
    {
      "source_id": "bme280",
      "page": 30,
      "snippet": "The 'press' register contains the raw pressure measurement output data up[19:0]."
    },
    {
      "source_id": "bme280",
      "page": 31,
      "snippet": "The 'temp' register contains the raw temperature measurement output data ut[19:0]."
    },
    {
      "source_id": "bme280",
      "page": 31,
      "snippet": "The 'hum' register contains the raw humidity measurement output data uh[15:0]."
    },
    {
      "source_id": "bme280",
      "page": 24,
      "snippet": "The trimming parameters are programmed into the devices' non-volatile memory (NVM) during production"
    },
    {
      "source_id": "bme280",
      "page": 23,
      "snippet": "To read out data after a conversion, it is strongly recommended to use a burst read"
    },
    {
      "source_id": "bme280",
      "page": 8,
      "snippet": "Start-up time                                    | t startup   | Time to first communication after both V DD > 1.58 V and V DDIO > 0.65 V |       |       | 2        | ms"
    },
    {
      "source_id": "bme280",
      "page": 51,
      "snippet": "The active measurement time depends on the selected values for humidity, temperature and pressure oversampling"
    },
    {
      "source_id": "bme280",
      "page": 49,
      "snippet": "Compensation formulas in double precision floating point"
    },
    {
      "source_id": "bme280",
      "page": 54,
      "snippet": "0 Sensor OK, 10 Communication error or wrong device found, 20 Trimming data out of bound"
    },
    {
      "source_id": "bme280",
      "page": 14,
      "snippet": "After powering up, the sensor settles in sleep mode"
    }
  ],
