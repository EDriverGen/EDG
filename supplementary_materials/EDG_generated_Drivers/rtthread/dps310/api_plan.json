{
  "eval_class": "multi_channel",
  "init_call": "dps310_init(&g_eval_dev, bus)",
  "channels": [
    {
      "id": "pressure",
      "call": "dps310_read_pressure(&g_eval_dev, &pressure_raw)",
      "out_arg": "pressure_raw",
      "out_type": "int32_t",
      "physical_unit": "raw_count"
    },
    {
      "id": "temperature",
      "call": "dps310_read_temperature(&g_eval_dev, &temperature_mdegc)",
      "out_arg": "temperature_mdegc",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    }
  ],
  "dev_struct_type": "struct dps310_device",
  "init_extra_setup_c": "struct rt_i2c_bus_device *bus = rt_i2c_bus_device_find(bus_name);\nif (bus == RT_NULL) { return DRIVERGEN_EVAL_ERR_INVALID; }"
}
