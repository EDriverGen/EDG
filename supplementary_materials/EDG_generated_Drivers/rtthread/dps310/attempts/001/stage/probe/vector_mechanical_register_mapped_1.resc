:name: dps310_eval
:description: I2C vector test for dps310

$bin = @<RUN_DIR>/attempts/001/stage/out/dps310_rtthread.elf

mach create "dps310_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/001/stage/probe/platform_mechanical_register_mapped_1.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
