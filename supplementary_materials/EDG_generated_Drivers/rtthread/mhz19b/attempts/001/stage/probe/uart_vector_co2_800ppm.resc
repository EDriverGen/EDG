:name: mhz19b_eval
:description: UART vector test for mhz19b

$bin = @<RUN_DIR>/attempts/001/stage/out/mhz19b_rtthread.elf

mach create "mhz19b_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/001/stage/probe/uart_platform_co2_800ppm.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
