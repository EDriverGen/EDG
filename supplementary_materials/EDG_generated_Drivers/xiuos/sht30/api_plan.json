{
  "eval_class": "multi_channel",
  "init_call": "sht30_init(&g_eval_dev, bus_handle)",
  "channels": [
    {
      "id": "temp",
      "call": "sht30_read_temp_humidity(&g_eval_dev, &temp_milliC, &humidity_milliPct)",
      "out_arg": "temp_milliC",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    },
    {
      "id": "humidity",
      "call": "sht30_read_temp_humidity(&g_eval_dev, &temp_milliC, &humidity_milliPct)",
      "out_arg": "humidity_milliPct",
      "out_type": "int32_t",
      "physical_unit": "milli_percent"
    }
  ],
  "dev_struct_type": "struct sht30_device",
  "init_extra_setup_c": "struct I2cBus *bus_handle = (struct I2cBus *)bus_name;"
}
