:name: bme280_eval
:description: I2C vector test for bme280

$bin = @<RUN_DIR>/attempts/003/stage/out/bme280_xiuos.elf

mach create "bme280_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/003/stage/probe/platform_zero_values.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
