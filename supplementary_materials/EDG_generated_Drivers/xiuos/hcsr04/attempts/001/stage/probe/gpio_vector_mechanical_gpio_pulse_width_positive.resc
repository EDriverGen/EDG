:name: hcsr04_eval
:description: GPIO pulse-timing vector test for hcsr04

$bin = @<RUN_DIR>/attempts/001/stage/out/hcsr04_xiuos.elf

mach create "hcsr04_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/001/stage/probe/gpio_platform_mechanical_gpio_pulse_width_positive.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
