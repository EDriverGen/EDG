  "error_conditions": [
    {
      "condition": "I2C NACK on address or data phase",
      "detection": "If the controller receives NACK after the control byte, register address, or data byte, the transaction did not complete.",
      "driver_action": "abort transaction and report -EIO"
    },
    {
      "condition": "Read/write to reserved or invalid register address",
      "detection": "If the driver programs an address outside the documented register map, the result is undefined and may not ACK or may access unintended state.",
      "driver_action": "reject in driver and return -EINVAL"
    },
    {
      "condition": "Interrupt expected but INT pin remains asserted after reading associated GPIO or INTCAP",
      "detection": "If IOC is enabled and the associated GPIO/INTCAP read does not deassert the interrupt, the interrupt condition may still be pending on the other port or mirrored source.",
      "driver_action": "retry associated port read once then surface error"
    },
    {
      "condition": "RESET pulse too short",
      "detection": "If RESET low is shorter than 1 us, the reset condition is not guaranteed.",
      "driver_action": "abort initialization and report -EIO"
    },
    {
      "condition": "GPIO/INTCAP read returns stale interrupt capture after another pending IOC",
      "detection": "If GPIO is read before INTCAP while another IOC is pending, the datasheet warns INTCAP may update after the clear; captured data can be lost.",
      "driver_action": "prefer INTCAP first; if lost capture is detected, report data corruption"
    },
    {
