{
  "expected_transactions": [
    {
      "phase": "init",
      "addr_or_pin": "0x20",
      "write_prefix_any_of": [
        [
          "0x00",
          "0x00"
        ]
      ],
      "note": "IODIRA=0x00: all GPA outputs"
    },
    {
      "phase": "init",
      "addr_or_pin": "0x20",
      "write_prefix_any_of": [
        [
          "0x01",
          "0x00"
        ]
      ],
      "note": "IODIRB=0x00: all GPB outputs"
    },
    {
      "phase": "read_porta",
      "addr_or_pin": "0x20",
      "write_prefix_any_of": [
        [
          "0x12"
        ]
      ],
      "note": "Set pointer to GPIOA"
    },
    {
      "phase": "read_porta",
      "addr_or_pin": "0x20",
      "write_prefix_any_of": [
        []
      ],
      "note": "Read GPIOA byte"
    },
    {
      "phase": "read_portb",
      "addr_or_pin": "0x20",
      "write_prefix_any_of": [
        [
          "0x13"
        ]
      ],
      "note": "Set pointer to GPIOB"
    },
    {
      "phase": "read_portb",
      "addr_or_pin": "0x20",
      "write_prefix_any_of": [
        []
      ],
      "note": "Read GPIOB byte"
    }
  ],
  "test_stimuli": [
    {
      "name": "porta_all_high",
      "mock_preload": {
        "0x12": [
          "0xFF"
        ]
      },
      "expected_channels": {
        "gpio_a0": 1,
        "gpio_a1": 1,
        "gpio_a2": 1,
        "gpio_a3": 1,
        "gpio_a4": 1,
        "gpio_a5": 1,
        "gpio_a6": 1,
        "gpio_a7": 1
      },
      "derivation": "GPIOA=0xFF: each bit extracted via (byte>>bit)&1 yields 1."
    },
    {
      "name": "porta_bit0_only",
      "mock_preload": {
        "0x12": [
          "0x01"
        ]
      },
      "expected_channels": {
        "gpio_a0": 1,
        "gpio_a1": 0,
        "gpio_a2": 0,
        "gpio_a3": 0,
        "gpio_a4": 0,
        "gpio_a5": 0,
        "gpio_a6": 0,
        "gpio_a7": 0
      },
      "derivation": "GPIOA=0x01: bit0=1, bits1-7=0."
    },
    {
      "name": "portb_mixed",
      "mock_preload": {
        "0x13": [
          "0xA4"
        ]
      },
      "expected_channels": {
        "gpio_b0": 0,
        "gpio_b1": 0,
        "gpio_b2": 1,
        "gpio_b3": 0,
        "gpio_b4": 0,
        "gpio_b5": 1,
        "gpio_b6": 0,
        "gpio_b7": 1
      },
      "derivation": "GPIOB=0xA4: bits: b7=1, b6=0, b5=1, b4=0, b3=0, b2=1, b1=0, b0=0."
    }
  ]
}
