{
  "eval_class": "multi_channel",
  "init_call": "pca9685_init(&g_eval_dev, bus_handle)",
  "init_extra_setup_c": "struct i2c_master_s *bus_handle = (struct i2c_master_s *)board_i2cbus_initialize(1);\nif (bus_handle == NULL) { return DRIVERGEN_EVAL_ERR_INVALID; }",
  "dev_struct_type": "struct pca9685_dev_s",
  "channels": [
    {
      "id": "led0",
      "call": "pca9685_read_pwm_channel(&g_eval_dev, 0, &led0)",
      "out_arg": "led0",
      "out_type": "uint16_t"
    },
    {
      "id": "led1",
      "call": "pca9685_read_pwm_channel(&g_eval_dev, 1, &led1)",
      "out_arg": "led1",
      "out_type": "uint16_t"
    }
  ]
}
