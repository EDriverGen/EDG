{
  "expected_transactions": [
    {
      "phase": "init",
      "addr_or_pin": "0x20",
      "write_prefix_any_of": [
        [
          "0x00",
          "0x00"
        ]
      ],
      "note": "IODIRA=0x00: all GPA outputs"
    },
    {
      "phase": "init",
      "addr_or_pin": "0x20",
      "write_prefix_any_of": [
        [
          "0x01",
          "0x00"
        ]
      ],
      "note": "IODIRB=0x00: all GPB outputs"
    },
    {
      "phase": "read_gpio_porta",
      "addr_or_pin": "0x20",
      "write_prefix_any_of": [
        [
          "0x12"
        ]
      ],
      "note": "Set pointer to GPIOA"
    },
    {
      "phase": "read_gpio_porta",
      "addr_or_pin": "0x20",
      "write_prefix_any_of": [
        []
      ],
      "note": "Read GPIOA byte"
    },
    {
      "phase": "read_gpio_portb",
      "addr_or_pin": "0x20",
      "write_prefix_any_of": [
        [
          "0x13"
        ]
      ],
      "note": "Set pointer to GPIOB"
    },
    {
      "phase": "read_gpio_portb",
      "addr_or_pin": "0x20",
      "write_prefix_any_of": [
        []
      ],
      "note": "Read GPIOB byte"
    }
  ],
  "test_stimuli": [
    {
      "name": "porta_all_high",
      "mock_preload": {
        "0x12": [
          "0xFF"
        ],
        "0x13": [
          "0x00"
        ]
      },
      "expected_channels": {
        "gpio_a0": 1,
        "gpio_a1": 1,
        "gpio_a2": 1,
        "gpio_a3": 1,
        "gpio_a4": 1,
        "gpio_a5": 1,
        "gpio_a6": 1,
        "gpio_a7": 1,
        "gpio_b0": 0,
        "gpio_b1": 0,
        "gpio_b2": 0,
        "gpio_b3": 0,
        "gpio_b4": 0,
        "gpio_b5": 0,
        "gpio_b6": 0,
        "gpio_b7": 0
      },
      "derivation": "GPIOA=0xFF: each bit (>>n)&1 = 1; GPIOB=0x00: each bit = 0"
    },
    {
      "name": "porta_mixed_portb_all_high",
      "mock_preload": {
        "0x12": [
          "0x55"
        ],
        "0x13": [
          "0xFF"
        ]
      },
      "expected_channels": {
        "gpio_a0": 1,
        "gpio_a1": 0,
        "gpio_a2": 1,
        "gpio_a3": 0,
        "gpio_a4": 1,
        "gpio_a5": 0,
        "gpio_a6": 1,
        "gpio_a7": 0,
        "gpio_b0": 1,
        "gpio_b1": 1,
        "gpio_b2": 1,
        "gpio_b3": 1,
        "gpio_b4": 1,
        "gpio_b5": 1,
        "gpio_b6": 1,
        "gpio_b7": 1
      },
      "derivation": "GPIOA=0x55: bits 0,2,4,6=1; bits 1,3,5,7=0; GPIOB=0xFF: all bits=1"
    },
    {
      "name": "all_low",
      "mock_preload": {
        "0x12": [
          "0x00"
        ],
        "0x13": [
          "0x00"
        ]
      },
      "expected_channels": {
        "gpio_a0": 0,
        "gpio_a1": 0,
        "gpio_a2": 0,
        "gpio_a3": 0,
        "gpio_a4": 0,
        "gpio_a5": 0,
        "gpio_a6": 0,
        "gpio_a7": 0,
        "gpio_b0": 0,
        "gpio_b1": 0,
        "gpio_b2": 0,
        "gpio_b3": 0,
        "gpio_b4": 0,
        "gpio_b5": 0,
        "gpio_b6": 0,
        "gpio_b7": 0
      },
      "derivation": "GPIOA=0x00: all bits=0; GPIOB=0x00: all bits=0"
    }
  ]
}
