:name: w25q64jv_eval
:description: SPI vector test for w25q64jv

$bin = @<RUN_DIR>/attempts/001/stage/out/w25q64jv_nuttx.elf

mach create "w25q64jv_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/001/stage/probe/spi_platform_mechanical_memory_probe_1.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
