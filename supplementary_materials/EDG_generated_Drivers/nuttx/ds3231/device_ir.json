  "conversion_formulae": [
    {
      "name": "temp_formula",
      "formula": "Temperature (quarter degrees) = (MSB << 2) | (LSB >> 6); if sign bit set, subtract 512. Result in quarter degrees Celsius.",
      "integer_approximation_expression": {
        "expression": "(((temp_msb << 2) | (temp_lsb >> 6)) & 0x1FF) - (((temp_msb << 2) | (temp_lsb >> 6)) & 0x200)",
        "inputs": [
          {
            "name": "temp_msb",
            "byte_source": "temp_msb:8",
            "description": "Temperature MSB register (11h), 8-bit two's complement integer part."
          },
          {
            "name": "temp_lsb",
            "byte_source": "temp_lsb:8",
            "description": "Temperature LSB register (12h), upper 2 bits are fractional part."
          }
        ],
        "output": {
          "name": "temperature_quarter_deg",
          "unit": "quarter_degC"
        }
      }
    }
  ],
