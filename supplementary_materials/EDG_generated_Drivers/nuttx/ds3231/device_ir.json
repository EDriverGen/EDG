{
  "device_id": "ds3231",
  "bus_type": "i2c",
  "address_rule": {
    "type": "fixed",
    "addressing_form": "7-bit",
    "addresses": [
      {
        "address": "0x68",
        "description": "I2C slave address (1101000)",
        "is_default": true
      }
    ]
  },
  "register_map": {
    "total_size_bytes": 19,
    "addressing": "1-byte",
    "auto_increment": true,
    "page_size_bytes": null,
    "write_busy_ms": null,
    "notes": "Address pointer wraps from 12h to 00h on multibyte access."
  },
  "read_channels": [
    {
      "id": "seconds",
      "raw_type": "uint8",
      "physical_unit": "bcd",
      "flow_id": "read_time",
      "source_bytes": [
        "seconds_reg"
      ],
      "formula_id": null,
      "notes": "BCD format, range 00-59"
    },
    {
      "id": "minutes",
      "raw_type": "uint8",
      "physical_unit": "bcd",
      "flow_id": "read_time",
      "source_bytes": [
        "minutes_reg"
      ],
      "formula_id": null,
      "notes": "BCD format, range 00-59"
    },
    {
      "id": "hours",
      "raw_type": "uint8",
      "physical_unit": "bcd",
      "flow_id": "read_time",
      "source_bytes": [
        "hours_reg"
      ],
      "formula_id": null,
      "notes": "12/24 hour mode, BCD"
    },
    {
      "id": "day",
      "raw_type": "uint8",
      "physical_unit": "day_of_week",
      "flow_id": "read_time",
      "source_bytes": [
        "day_reg"
      ],
      "formula_id": null,
      "notes": "Day of week, 1-7"
    },
    {
      "id": "date",
      "raw_type": "uint8",
      "physical_unit": "bcd",
      "flow_id": "read_time",
      "source_bytes": [
        "date_reg"
      ],
      "formula_id": null,
      "notes": "BCD format, range 01-31"
    },
    {
      "id": "month",
      "raw_type": "uint8",
      "physical_unit": "bcd",
      "flow_id": "read_time",
      "source_bytes": [
        "month_reg"
      ],
      "formula_id": null,
      "notes": "BCD format, range 01-12, includes century bit"
    },
    {
      "id": "year",
      "raw_type": "uint8",
      "physical_unit": "bcd",
      "flow_id": "read_time",
      "source_bytes": [
        "year_reg"
      ],
      "formula_id": null,
      "notes": "BCD format, range 00-99"
    },
    {
      "id": "temperature",
      "raw_type": "int16",
      "physical_unit": "quarter_degC",
      "flow_id": "read_temperature",
      "source_bytes": [
        "temp_msb",
        "temp_lsb"
      ],
      "formula_id": "temp_formula",
      "notes": "10-bit two's complement, 0.25°C resolution"
    },
    {
      "id": "alarm1",
      "raw_type": "bytes",
      "physical_unit": "alarm_settings",
      "flow_id": "set_alarm1",
      "source_bytes": null,
      "formula_id": null,
      "notes": "Alarm 1 registers 07h-0Ah"
    },
    {
      "id": "alarm2",
      "raw_type": "bytes",
      "physical_unit": "alarm_settings",
      "flow_id": "set_alarm2",
      "source_bytes": null,
      "formula_id": null,
      "notes": "Alarm 2 registers 0Bh-0Dh"
    }
  ],
  "access_model": {
    "kind": "register_pointer",
    "address_bytes": 1,
    "read_requires_pointer": true,
    "direct_read_after_write": false,
    "notes": "Write pointer byte, then read/write data bytes; auto-increment after each byte."
  },
  "operation_flows": [
    {
      "flow_id": "read_time",
      "kind": "read",
      "channels": [
        "seconds",
        "minutes",
        "hours",
        "day",
        "date",
        "month",
        "year"
      ],
      "preconditions": [],
      "steps": [
        {
          "op": "write_then_read",
          "transaction": {
            "kind": "write_then_read",
            "bytes": [
              "0x00"
            ],
            "length": 7,
            "pointer_target": "Seconds"
          },
          "notes": "Set pointer to 00h, then read 7 bytes for time registers."
        }
      ],
      "outputs": [
        {
          "channel": "seconds",
          "byte_source": "byte0",
          "formula_id": null,
          "unit": "bcd"
        },
        {
          "channel": "minutes",
          "byte_source": "byte1",
          "formula_id": null,
          "unit": "bcd"
        },
        {
          "channel": "hours",
          "byte_source": "byte2",
          "formula_id": null,
          "unit": "bcd"
        },
        {
          "channel": "day",
          "byte_source": "byte3",
          "formula_id": null,
          "unit": "day_of_week"
        },
        {
          "channel": "date",
          "byte_source": "byte4",
          "formula_id": null,
          "unit": "bcd"
        },
        {
          "channel": "month",
          "byte_source": "byte5",
          "formula_id": null,
          "unit": "bcd"
        },
        {
          "channel": "year",
          "byte_source": "byte6",
          "formula_id": null,
          "unit": "bcd"
        }
      ],
      "notes": "Time registers are read from secondary buffers to avoid update during read."
    },
    {
      "flow_id": "write_time",
      "kind": "write",
      "channels": [
        "seconds",
        "minutes",
        "hours",
        "day",
        "date",
        "month",
        "year"
      ],
      "preconditions": [],
      "steps": [
        {
          "op": "write",
          "transaction": {
            "kind": "write",
            "bytes": [
              "0x00",
              null,
              null,
              null,
              null,
              null,
              null,
              null
            ],
            "pointer_target": "Seconds"
          },
          "notes": "Write pointer 00h then 7 bytes of time data. Null placeholders for runtime values."
        }
      ],
      "outputs": [],
      "notes": "Write seconds register first resets countdown chain; remaining registers must be written within 1 second."
    },
    {
      "flow_id": "read_temperature",
      "kind": "read",
      "channels": [
        "temperature"
      ],
      "preconditions": [],
      "steps": [
        {
          "op": "write",
          "transaction": {
            "kind": "write",
            "bytes": [
              "0x0E",
              "0x20"
            ],
            "pointer_target": "Control"
          },
          "notes": "Set CONV bit (bit 5) to 1 to start temperature conversion."
        },
        {
          "op": "poll_until",
          "register": "Control",
          "mask": "0x20",
          "value": "0x00",
          "timeout_ms": 200,
          "interval_ms": 10,
          "notes": "Poll CONV bit until it goes to 0, indicating conversion complete."
        },
        {
          "op": "write_then_read",
          "transaction": {
            "kind": "write_then_read",
            "bytes": [
              "0x11"
            ],
            "length": 2,
            "pointer_target": "Temperature MSB"
          },
          "notes": "Set pointer to 11h, then read 2 bytes: MSB and LSB of temperature."
        }
      ],
      "outputs": [
        {
          "channel": "temperature",
          "byte_source": "temp_msb:8 || temp_lsb:8",
          "formula_id": "temp_formula",
          "unit": "quarter_degC"
        }
      ],
      "notes": "Temperature registers are read-only. Conversion triggered by setting CONV bit."
    },
    {
      "flow_id": "set_alarm1",
      "kind": "write",
      "channels": [
        "alarm1"
      ],
      "preconditions": [],
      "steps": [
        {
          "op": "write",
          "transaction": {
            "kind": "write",
            "bytes": [
              "0x07",
              null,
              null,
              null,
              null
            ],
            "pointer_target": "Alarm 1 Seconds"
          },
          "notes": "Write pointer 07h then 4 bytes for alarm 1 registers."
        }
      ],
      "outputs": [],
      "notes": "Alarm 1 registers: 07h (seconds), 08h (minutes), 09h (hours), 0Ah (day/date)."
    },
    {
      "flow_id": "set_alarm2",
      "kind": "write",
      "channels": [
        "alarm2"
      ],
      "preconditions": [],
      "steps": [
        {
          "op": "write",
          "transaction": {
            "kind": "write",
            "bytes": [
              "0x0B",
              null,
              null,
              null
            ],
            "pointer_target": "Alarm 2 Minutes"
          },
          "notes": "Write pointer 0Bh then 3 bytes for alarm 2 registers."
        }
      ],
      "outputs": [],
      "notes": "Alarm 2 registers: 0Bh (minutes), 0Ch (hours), 0Dh (day/date)."
    },
    {
      "flow_id": "clear_alarm_flags",
      "kind": "other",
      "channels": [
        "alarm1",
        "alarm2"
      ],
      "preconditions": [],
      "steps": [
        {
          "op": "write",
          "transaction": {
            "kind": "write",
            "bytes": [
              "0x0F",
              "0x00"
            ],
            "pointer_target": "Status"
          },
          "notes": "Write 0 to status register to clear A1F and A2F bits. Only bits written to 0 are cleared."
        }
      ],
      "outputs": [],
      "notes": "Alarm flags are cleared by writing logic 0 to the respective bit."
    },
    {
      "flow_id": "force_temperature_conversion",
      "kind": "other",
      "channels": [
        "temperature"
      ],
      "preconditions": [],
      "steps": [
        {
          "op": "write",
          "transaction": {
            "kind": "write",
            "bytes": [
              "0x0E",
              "0x20"
            ],
            "pointer_target": "Control"
          },
          "notes": "Set CONV bit (bit 5) to 1 to start temperature conversion."
        },
        {
          "op": "poll_until",
          "register": "Control",
          "mask": "0x20",
          "value": "0x00",
          "timeout_ms": 200,
          "interval_ms": 10,
          "notes": "Poll CONV bit until it goes to 0, indicating conversion complete."
        }
      ],
      "outputs": [],
      "notes": "Conversion takes 125-200 ms. BSY bit goes high for ~2ms after CONV set."
    },
    {
      "flow_id": "i2c_resync",
      "kind": "other",
      "channels": [],
      "preconditions": [],
      "steps": [
        {
          "op": "set_signal",
          "signal": "SCL",
          "notes": "Toggle SCL until SDA is observed high."
        },
        {
          "op": "set_signal",
          "signal": "SDA",
          "notes": "Pull SDA low while SCL high to generate START condition."
        }
      ],
      "outputs": [],
      "notes": "Resynchronize I2C bus after microcontroller reset."
    }
  ],
  "raw_encoding": {
    "byte_order": "big_endian",
    "bit_width": 16,
    "effective_bits": 10,
    "signed": true,
    "right_shift": 6,
    "sign_extend_from_bit": 9,
    "notes": "Temperature: MSB (11h) is integer part, LSB (12h) upper 2 bits are fractional (0.25°C resolution)."
  },
