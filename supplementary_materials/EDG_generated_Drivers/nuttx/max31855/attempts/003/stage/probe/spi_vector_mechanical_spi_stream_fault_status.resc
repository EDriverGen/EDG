:name: max31855_eval
:description: SPI vector test for max31855

$bin = @<RUN_DIR>/attempts/003/stage/out/max31855_nuttx.elf

mach create "max31855_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/003/stage/probe/spi_platform_mechanical_spi_stream_fault_status.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
