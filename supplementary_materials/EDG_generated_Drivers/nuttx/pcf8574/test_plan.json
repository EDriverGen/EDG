{
  "expected_transactions": [
    {
      "phase": "read_cycle",
      "addr_or_pin": "0x20",
      "write_prefix_any_of": [],
      "note": "flow_read_write_1: direct read read_port"
    }
  ],
  "test_stimuli": [
    {
      "name": "all_pins_high",
      "mock_preload": {
        "read_bytes": [
          "0xFF"
        ]
      },
      "expected_channels": {
        "p0": 1,
        "p1": 1,
        "p2": 1,
        "p3": 1,
        "p4": 1,
        "p5": 1,
        "p6": 1,
        "p7": 1,
        "int": 1
      },
      "derivation": "Port byte 0xFF: bit0=1 => p0=1, bit1=1 => p1=1, bit2=1 => p2=1, bit3=1 => p3=1, bit4=1 => p4=1, bit5=1 => p5=1, bit6=1 => p6=1, bit7=1 => p7=1; int is bitwise OR of all bits = 1."
    },
    {
      "name": "all_pins_low",
      "mock_preload": {
        "read_bytes": [
          "0x00"
        ]
      },
      "expected_channels": {
        "p0": 0,
        "p1": 0,
        "p2": 0,
        "p3": 0,
        "p4": 0,
        "p5": 0,
        "p6": 0,
        "p7": 0,
        "int": 0
      },
      "derivation": "Port byte 0x00: all bits 0 => all channels 0; int = 0."
    },
    {
      "name": "mixed_pins",
      "mock_preload": {
        "read_bytes": [
          "0x55"
        ]
      },
      "expected_channels": {
        "p0": 1,
        "p1": 0,
        "p2": 1,
        "p3": 0,
        "p4": 1,
        "p5": 0,
        "p6": 1,
        "p7": 0,
        "int": 1
      },
      "derivation": "Port byte 0x55 = 0b01010101: bit0=1 => p0=1, bit1=0 => p1=0, bit2=1 => p2=1, bit3=0 => p3=0, bit4=1 => p4=1, bit5=0 => p5=0, bit6=1 => p6=1, bit7=0 => p7=0; int = OR of all bits = 1."
    }
  ]
}
