{
  "eval_class": "multi_channel",
  "init_call": "bme280_init(&g_eval_dev, bus_handle)",
  "init_extra_setup_c": "struct i2c_master_s *bus_handle = (struct i2c_master_s *)board_i2cbus_initialize(1);\nif (bus_handle == NULL) { return DRIVERGEN_EVAL_ERR_INVALID; }",
  "dev_struct_type": "struct bme280_dev",
  "channels": [
    {
      "id": "temp",
      "call": "bme280_read_all(&g_eval_dev, &temp_raw, &pressure_raw, &humidity_raw)",
      "out_arg": "temp_raw",
      "out_type": "int32_t",
      "physical_unit": "raw_count"
    },
    {
      "id": "pressure",
      "call": "bme280_read_all(&g_eval_dev, &temp_raw, &pressure_raw, &humidity_raw)",
      "out_arg": "pressure_raw",
      "out_type": "int32_t",
      "physical_unit": "raw_count"
    },
    {
      "id": "humidity",
      "call": "bme280_read_all(&g_eval_dev, &temp_raw, &pressure_raw, &humidity_raw)",
      "out_arg": "humidity_raw",
      "out_type": "int32_t",
      "physical_unit": "raw_count"
    }
  ]
}
