{
  "eval_class": "multi_channel",
  "init_call": "sht30_init(&g_eval_dev, bus_handle)",
  "init_extra_setup_c": "struct i2c_master_s *bus_handle = (struct i2c_master_s *)bus_name;",
  "dev_struct_type": "struct sht30_dev_s",
  "channels": [
    {
      "id": "temp",
      "call": "sht30_read_measurement(&g_eval_dev, &temp_milliC, &hum_milliPct)",
      "out_arg": "temp_milliC",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    },
    {
      "id": "humidity",
      "call": "sht30_read_measurement(&g_eval_dev, &temp_milliC, &hum_milliPct)",
      "out_arg": "hum_milliPct",
      "out_type": "int32_t",
      "physical_unit": "milli_percent"
    }
  ]
}
