:name: mpu6050_eval
:description: I2C vector test for mpu6050

$bin = @<RUN_DIR>/attempts/002/stage/out/mpu6050_chibios.elf

mach create "mpu6050_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/002/stage/probe/platform_mechanical_register_mapped_1.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
