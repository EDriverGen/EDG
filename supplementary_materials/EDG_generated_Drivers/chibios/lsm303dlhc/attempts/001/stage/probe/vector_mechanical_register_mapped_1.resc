:name: lsm303dlhc_eval
:description: I2C vector test for lsm303dlhc

$bin = @<RUN_DIR>/attempts/001/stage/out/lsm303dlhc_chibios.elf

mach create "lsm303dlhc_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/001/stage/probe/platform_mechanical_register_mapped_1.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
