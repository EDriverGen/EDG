{
  "eval_class": "multi_channel",
  "init_call": "lsm303dlhc_init(&g_eval_dev, (void *)bus_name)",
  "init_extra_setup_c": "void *bus_handle = (void *)bus_name;",
  "dev_struct_type": "struct lsm303dlhc_dev",
  "channels": [
    {
      "id": "accel_x",
      "call": "lsm303dlhc_read_accel(&g_eval_dev, &ax, &ay, &az)",
      "out_arg": "ax",
      "out_type": "int16_t",
      "physical_unit": "raw_count"
    },
    {
      "id": "accel_y",
      "call": "lsm303dlhc_read_accel(&g_eval_dev, &ax, &ay, &az)",
      "out_arg": "ay",
      "out_type": "int16_t",
      "physical_unit": "raw_count"
    },
    {
      "id": "accel_z",
      "call": "lsm303dlhc_read_accel(&g_eval_dev, &ax, &ay, &az)",
      "out_arg": "az",
      "out_type": "int16_t",
      "physical_unit": "raw_count"
    },
    {
      "id": "mag_x",
      "call": "lsm303dlhc_read_mag(&g_eval_dev, &mx, &my, &mz)",
      "out_arg": "mx",
      "out_type": "int16_t",
      "physical_unit": "raw_count"
    },
    {
      "id": "mag_y",
      "call": "lsm303dlhc_read_mag(&g_eval_dev, &mx, &my, &mz)",
      "out_arg": "my",
      "out_type": "int16_t",
      "physical_unit": "raw_count"
    },
    {
      "id": "mag_z",
      "call": "lsm303dlhc_read_mag(&g_eval_dev, &mx, &my, &mz)",
      "out_arg": "mz",
      "out_type": "int16_t",
      "physical_unit": "raw_count"
    },
    {
      "id": "temp",
      "call": "lsm303dlhc_read_temp(&g_eval_dev, &t)",
      "out_arg": "t",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    }
  ]
}
