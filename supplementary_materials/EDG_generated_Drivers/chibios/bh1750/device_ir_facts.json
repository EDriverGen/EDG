  "evidence_spans": [
    {
      "source_id": "bh1750",
      "page": 10,
      "snippet": "Slave Address is 2 types, it is determined by ADDR Terminal ADDR = 'H' (ADDR ≥ 0.7VCC) → '1011100' ADDR = 'L' (ADDR ≤ 0.3VCC) → '0100011'"
    },
    {
      "source_id": "bh1750",
      "page": 5,
      "snippet": "Reset command is for only reset Illuminance data register. ( reset value is '0' )"
    },
    {
      "source_id": "bh1750",
      "page": 5,
      "snippet": "Continuously H-Resolution Mode ... Start measurement at 1lx resolution. Measurement Time is typically 120ms."
    },
    {
      "source_id": "bh1750",
      "page": 5,
      "snippet": "Change Measurement time ( High bit ) ... 01000_MT[7,6,5]"
    },
    {
      "source_id": "bh1750",
      "page": 11,
      "snippet": "H-reslution mode : Illuminance per 1 count ( lx / count )    = 1 / 1.2 *( 69 / X )"
    },
    {
      "source_id": "bh1750",
      "page": 6,
      "snippet": "DVI is I2C bus reference voltage terminal. And it is also asynchronous reset terminal. It is necessary to set to 'L' after VCC is supplied."
    }
  ],
