:name: tmp105_eval
:description: I2C vector test for tmp105

$bin = @<RUN_DIR>/attempts/002/stage/out/tmp105_chibios.elf

mach create "tmp105_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/002/stage/probe/platform_mechanical_single_channel_zero.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
