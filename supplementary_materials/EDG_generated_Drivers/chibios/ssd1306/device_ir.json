          "notes": "Medium contrast"
        },
        {
          "op": "write",
          "transaction": {
            "kind": "write",
            "bytes": [
              "0xA4"
            ],
            "pointer_target": null,
            "notes": "Entire Display ON: resume to RAM content display"
