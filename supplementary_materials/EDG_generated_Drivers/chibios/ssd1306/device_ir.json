  "address_rule": {
    "type": "address_pins",
    "addressing_form": "7-bit",
    "addresses": [
      {
        "address": "0x3C",
        "description": "SA0 (D/C# pin) LOW",
        "is_default": true
      },
      {
        "address": "0x3D",
        "description": "SA0 (D/C# pin) HIGH",
        "is_default": false
      }
    ],
    "default_address_resolution": {
      "method": "first-fallback",
      "confidence": "low",
      "warning": "Multiple address entries without an explicit default; selecting the first as default. Confirm against the datasheet — see DEFAULT_KEYWORD_PATTERNS in drivergen.core.ir_canonicalize."
    }
  },
  "register_map": {
    "total_size_bytes": 1024,
    "addressing": "pointer",
    "auto_increment": true,
    "page_size_bytes": 128,
    "write_busy_ms": null,
    "notes": "GDDRAM: 128x64 bits, organized as 8 pages of 128 bytes each. Column address auto-increments after each data write/read."
  },
  "read_channels": [
    {
      "id": "display",
      "raw_type": "bytes",
      "physical_unit": "pixel",
      "read_call_hint": "write_then_read",
      "flow_id": "read_display",
      "source_bytes": [
        "data_bytes"
      ],
      "source_signal": null,
      "formula_id": null,
      "notes": "Monochrome 128x64 pixel display. Data bytes written to GDDRAM define pixel states."
    }
  ],
  "access_model": {
    "kind": "register_pointer",
    "address_bytes": 1,
    "read_requires_pointer": true,
    "direct_read_after_write": false,
    "notes": "I2C interface uses control byte with D/C# bit to distinguish command vs data. No separate register pointer; commands are sent directly."
  },
  "operation_flows": [
    {
      "flow_id": "power_on",
      "kind": "power",
      "channels": [],
      "preconditions": [
        "VDD stable"
      ],
      "steps": [
        {
          "op": "set_signal",
          "signal": "RES#",
          "value": "LOW",
          "duration_us": 3,
          "notes": "Pull RES# LOW for at least 3us (t1)"
        },
        {
          "op": "set_signal",
          "signal": "RES#",
          "value": "HIGH",
          "notes": "Release RES# HIGH"
        },
        {
          "op": "delay",
          "delay_ms": 0.003,
          "notes": "Wait at least 3us (t2) after RES# HIGH before powering VCC"
        },
        {
          "op": "set_signal",
          "signal": "VCC",
          "value": "ON",
          "notes": "Power ON VCC"
        },
        {
          "op": "delay",
          "delay_ms": 100,
          "notes": "Wait 100ms (tAF) after VCC stable before sending AFh"
        },
        {
          "op": "write",
          "transaction": {
            "kind": "write",
            "bytes": [
              "0xAF"
            ],
            "pointer_target": null,
            "notes": "Send command AFh (Display ON)"
          },
          "notes": "Display ON command"
        }
      ],
      "outputs": [],
      "requires_human": false,
      "notes": "Power ON sequence per datasheet Figure 8-16"
    },
    {
      "flow_id": "power_off",
      "kind": "power",
      "channels": [],
      "preconditions": [],
      "steps": [
        {
          "op": "write",
          "transaction": {
            "kind": "write",
            "bytes": [
              "0xAE"
            ],
            "pointer_target": null,
            "notes": "Send command AEh (Display OFF)"
          },
          "notes": "Display OFF command"
        },
        {
          "op": "set_signal",
          "signal": "VCC",
          "value": "OFF",
          "notes": "Power OFF VCC"
        },
        {
          "op": "delay",
          "delay_ms": 100,
          "notes": "Wait tOFF (typ 100ms) before powering OFF VDD"
        },
        {
          "op": "set_signal",
          "signal": "VDD",
          "value": "OFF",
          "notes": "Power OFF VDD"
        }
      ],
      "outputs": [],
      "requires_human": false,
      "notes": "Power OFF sequence per datasheet Figure 8-17"
    },
    {
      "flow_id": "init_display",
      "kind": "init",
      "channels": [],
      "preconditions": [
        "Power ON sequence completed"
      ],
      "steps": [
        {
          "op": "write",
          "transaction": {
            "kind": "write",
            "bytes": [
              "0xAE"
            ],
            "pointer_target": null,
            "notes": "Display OFF"
          },
          "notes": "Ensure display is off during initialization"
        },
        {
          "op": "write",
          "transaction": {
            "kind": "write",
            "bytes": [
              "0xD5",
              "0x80"
            ],
            "pointer_target": null,
            "notes": "Set Display Clock Divide Ratio/Oscillator Frequency (reset value)"
          },
          "notes": "Default divide ratio=1, oscillator frequency=1000b"
        },
        {
          "op": "write",
          "transaction": {
            "kind": "write",
            "bytes": [
              "0xA8",
              "0x3F"
            ],
            "pointer_target": null,
            "notes": "Set Multiplex Ratio to 64 (N+1=64)"
          },
          "notes": "64 MUX for 64 rows"
        },
        {
          "op": "write",
          "transaction": {
            "kind": "write",
            "bytes": [
              "0xD3",
              "0x00"
            ],
            "pointer_target": null,
            "notes": "Set Display Offset to 0"
          },
          "notes": "No vertical shift"
        },
        {
          "op": "write",
          "transaction": {
            "kind": "write",
            "bytes": [
              "0x40"
            ],
            "pointer_target": null,
            "notes": "Set Display Start Line to row 0"
          },
          "notes": "RAM row 0 mapped to COM0"
        },
        {
          "op": "write",
          "transaction": {
            "kind": "write",
            "bytes": [
              "0xA1"
            ],
            "pointer_target": null,
            "notes": "Set Segment Re-map: column 127 mapped to SEG0"
          },
          "notes": "Horizontal flip"
