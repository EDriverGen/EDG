          "notes": "0 in RAM = OFF, 1 = ON"
        },
        {
          "op": "write",
          "transaction": {
            "kind": "write",
            "bytes": [
              "0x2E"
            ],
            "pointer_target": null,
            "notes": "Deactivate scroll"
