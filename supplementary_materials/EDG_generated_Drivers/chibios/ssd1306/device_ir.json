        {
          "op": "write",
          "transaction": {
            "kind": "write",
            "bytes": [
              "0xDA",
              "0x12"
            ],
            "pointer_target": null,
            "notes": "Set COM Pins Hardware Configuration: alternative pin configuration, disable left/right remap"
