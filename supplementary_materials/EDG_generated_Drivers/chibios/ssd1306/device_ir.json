          "notes": "Default alternative COM pin configuration"
        },
        {
          "op": "write",
          "transaction": {
            "kind": "write",
            "bytes": [
              "0x81",
              "0x7F"
            ],
            "pointer_target": null,
            "notes": "Set Contrast Control to 0x7F (reset value)"
