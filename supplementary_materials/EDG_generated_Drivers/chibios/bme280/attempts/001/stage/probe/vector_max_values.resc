:name: bme280_eval
:description: I2C vector test for bme280

$bin = @<RUN_DIR>/attempts/001/stage/out/bme280_chibios.elf

mach create "bme280_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/001/stage/probe/platform_max_values.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
