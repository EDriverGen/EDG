{
  "eval_class": "multi_channel",
  "init_call": "dps310_init(&g_eval_dev, (void *)bus_name)",
  "channels": [
    {
      "id": "pressure",
      "call": "dps310_read_pressure(&g_eval_dev, &pressure_raw)",
      "out_arg": "pressure_raw",
      "out_type": "int32_t",
      "physical_unit": "raw_count"
    },
    {
      "id": "temp",
      "call": "dps310_read_temp(&g_eval_dev, &temp_raw)",
      "out_arg": "temp_raw",
      "out_type": "int32_t",
      "physical_unit": "raw_count"
    }
  ],
  "dev_struct_type": "struct dps310_device",
  "init_extra_setup_c": "void *bus_handle = (void *)bus_name;"
}
