{
  "eval_class": "multi_channel",
  "init_call": "adxl345_init(&g_eval_dev, bus_handle)",
  "init_extra_setup_c": "void *bus_handle = (void *)bus_name;",
  "dev_struct_type": "struct adxl345_dev",
  "channels": [
    {
      "id": "accel_x",
      "call": "adxl345_read_xyz(&g_eval_dev, &ax, &ay, &az)",
      "out_arg": "ax",
      "out_type": "int16_t",
      "physical_unit": "raw_count"
    },
    {
      "id": "accel_y",
      "call": "adxl345_read_xyz(&g_eval_dev, &ax, &ay, &az)",
      "out_arg": "ay",
      "out_type": "int16_t",
      "physical_unit": "raw_count"
    },
    {
      "id": "accel_z",
      "call": "adxl345_read_xyz(&g_eval_dev, &ax, &ay, &az)",
      "out_arg": "az",
      "out_type": "int16_t",
      "physical_unit": "raw_count"
    }
  ]
}
