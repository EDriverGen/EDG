:name: ssd1306_eval
:description: I2C vector test for ssd1306

$bin = @<RUN_DIR>/attempts/001/stage/out/ssd1306_tobudos.elf

mach create "ssd1306_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/001/stage/probe/platform_frame_output_with_data.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
