{
  "eval_class": "multi_channel",
  "init_call": "mcp3008_init(&g_eval_dev, bus_handle)",
  "channels": [
    {
      "id": "ch0",
      "call": "mcp3008_read_channel(&g_eval_dev, 0, &ch0)",
      "out_arg": "ch0",
      "out_type": "uint16_t"
    },
    {
      "id": "ch1",
      "call": "mcp3008_read_channel(&g_eval_dev, 1, &ch1)",
      "out_arg": "ch1",
      "out_type": "uint16_t"
    }
  ],
  "dev_struct_type": "struct mcp3008_dev",
  "init_extra_setup_c": "void *bus_handle = (void *)bus_name;"
}
