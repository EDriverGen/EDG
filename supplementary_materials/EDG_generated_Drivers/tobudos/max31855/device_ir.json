          "unit": "milli_degC"
        }
      }
    },
    {
      "name": "internal_temp_formula",
      "formula": "T_internal = (signed_12bit_value) * 0.0625",
      "integer_approximation_expression": {
        "expression": "(((raw_12 >> 11) & 1) * (-2048) + ((raw_12 & 0x7FF) ^ ((raw_12 >> 11) & 1) * 0x800)) * 625 // 10000",
