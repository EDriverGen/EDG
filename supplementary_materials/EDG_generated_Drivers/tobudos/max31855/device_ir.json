      "name": "thermocouple_temp_formula",
      "formula": "T_thermocouple = (signed_14bit_value) * 0.25",
      "integer_approximation_expression": {
        "expression": "(((raw_14 >> 13) & 1) * (-8192) + ((raw_14 & 0x1FFF) ^ ((raw_14 >> 13) & 1) * 0x2000)) * 250 // 1000",
        "inputs": [
