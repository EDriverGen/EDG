  "evidence_spans": [
    {
      "source_id": "mcp23017",
      "page": 15,
      "snippet": "MCP23017 is a client I 2 C interface device that supports 7-bit client addressing, with the read/write bit filling out the control byte."
    },
    {
      "source_id": "mcp23017",
      "page": 13,
      "snippet": "The I 2 C write operation includes the control byte and register address sequence"
    },
    {
      "source_id": "mcp23017",
      "page": 14,
      "snippet": "followed by another control byte (including the Start condition and ACK) with the R/W bit set (R/W = 1 )."
    },
    {
      "source_id": "mcp23017",
      "page": 20,
      "snippet": "If BANK = 0 , the A/B registers are paired."
    }
  ],
