{
  "expected_transactions": [
    {
      "phase": "init",
      "addr_or_pin": "0x20",
      "write_prefix_any_of": [
        [
          "0x00",
          "0x00"
        ]
      ],
      "note": "IODIRA=0x00: all GPA outputs"
    },
    {
      "phase": "init",
      "addr_or_pin": "0x20",
      "write_prefix_any_of": [
        [
          "0x01",
          "0x00"
        ]
      ],
      "note": "IODIRB=0x00: all GPB outputs"
    },
    {
      "phase": "read_porta",
      "addr_or_pin": "0x20",
      "write_prefix_any_of": [
        [
          "0x12"
        ]
      ],
      "note": "Set pointer to GPIOA"
    },
    {
      "phase": "read_porta",
      "addr_or_pin": "0x20",
      "write_prefix_any_of": [],
      "note": "Read GPIOA byte"
    },
    {
      "phase": "read_portb",
      "addr_or_pin": "0x20",
      "write_prefix_any_of": [
        [
          "0x13"
        ]
      ],
      "note": "Set pointer to GPIOB"
    },
    {
      "phase": "read_portb",
      "addr_or_pin": "0x20",
      "write_prefix_any_of": [],
      "note": "Read GPIOB byte"
    }
  ],
  "test_stimuli": [
    {
      "name": "porta_all_high",
      "mock_preload": {
        "0x12": [
          "0xFF"
        ]
      },
      "expected_channels": {
        "gpio_a0": 1,
        "gpio_a1": 1,
        "gpio_a2": 1,
        "gpio_a3": 1,
        "gpio_a4": 1,
        "gpio_a5": 1,
        "gpio_a6": 1,
        "gpio_a7": 1
      },
      "derivation": "GPIOA=0xFF: each bit (raw_byte>>n)&1 = 1"
    },
    {
      "name": "porta_mixed",
      "mock_preload": {
        "0x12": [
          "0x55"
        ]
      },
      "expected_channels": {
        "gpio_a0": 1,
        "gpio_a1": 0,
        "gpio_a2": 1,
        "gpio_a3": 0,
        "gpio_a4": 1,
        "gpio_a5": 0,
        "gpio_a6": 1,
        "gpio_a7": 0
      },
      "derivation": "GPIOA=0x55: bit0=1, bit1=0, bit2=1, bit3=0, bit4=1, bit5=0, bit6=1, bit7=0"
    },
    {
      "name": "portb_all_low",
      "mock_preload": {
        "0x13": [
          "0x00"
        ]
      },
      "expected_channels": {
        "gpio_b0": 0,
        "gpio_b1": 0,
        "gpio_b2": 0,
        "gpio_b3": 0,
        "gpio_b4": 0,
        "gpio_b5": 0,
        "gpio_b6": 0,
        "gpio_b7": 0
      },
      "derivation": "GPIOB=0x00: each bit (raw_byte>>n)&1 = 0"
    }
  ]
}
