:name: pca9685_eval
:description: I2C vector test for pca9685

$bin = @<RUN_DIR>/attempts/002/stage/out/pca9685_threadx.elf

mach create "pca9685_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/002/stage/probe/platform_led0_duty_0_percent.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
