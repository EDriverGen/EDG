{
  "eval_class": "rtc",
  "init_call": "ds3231_init(&g_eval_dev, bus_handle)",
  "get_time_call": "ds3231_get_time(&g_eval_dev, &drv)",
  "set_time_call": "ds3231_set_time(&g_eval_dev, &drv)",
  "time_struct_decl": "struct ds3231_time drv;",
  "time_struct_from_in": "struct ds3231_time drv; drv.seconds = in->second; drv.minutes = in->minute; drv.hours = in->hour; drv.day = in->weekday; drv.date = in->day; drv.month = in->month; drv.year = in->year - 2000;",
  "time_fields": {
    "year": "drv.year + 2000",
    "month": "drv.month",
    "day": "drv.date",
    "hour": "drv.hours",
    "minute": "drv.minutes",
    "second": "drv.seconds",
    "weekday": "drv.day"
  },
  "dev_struct_type": "struct ds3231_dev",
  "init_extra_setup_c": "void *bus_handle = (void *)bus_name;",
  "preamble_c": "#include <string.h>"
}
