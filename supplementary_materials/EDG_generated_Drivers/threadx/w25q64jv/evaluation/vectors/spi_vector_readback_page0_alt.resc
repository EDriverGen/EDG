:name: w25q64jv_eval
:description: SPI vector test for w25q64jv

$bin = @<RUN_DIR>/evaluation/build/w25q64jv_threadx.elf

mach create "w25q64jv_eval"
machine LoadPlatformDescription @<RUN_DIR>/evaluation/vectors/spi_platform_readback_page0_alt.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
