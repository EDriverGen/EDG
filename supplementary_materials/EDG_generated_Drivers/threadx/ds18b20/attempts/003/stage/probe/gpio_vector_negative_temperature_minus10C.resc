:name: ds18b20_eval
:description: GPIO pulse-timing vector test for ds18b20

$bin = @<RUN_DIR>/attempts/003/stage/out/ds18b20_threadx.elf

mach create "ds18b20_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/003/stage/probe/gpio_platform_negative_temperature_minus10C.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
