{
  "eval_class": "multi_channel",
  "init_call": "sht30_init(&g_eval_dev, bus_handle)",
  "channels": [
    {
      "id": "temp",
      "call": "sht30_read_measurement(&g_eval_dev, &temp_milliC, &humidity_milliPercent)",
      "out_arg": "temp_milliC",
      "out_type": "int32_t",
      "physical_unit": "milli_degC"
    },
    {
      "id": "humidity",
      "call": "sht30_read_measurement(&g_eval_dev, &temp_milliC, &humidity_milliPercent)",
      "out_arg": "humidity_milliPercent",
      "out_type": "int32_t",
      "physical_unit": "milli_percent"
    }
  ],
  "dev_struct_type": "struct sht30_dev",
  "init_extra_setup_c": "void *bus_handle = (void *)bus_name;"
}
