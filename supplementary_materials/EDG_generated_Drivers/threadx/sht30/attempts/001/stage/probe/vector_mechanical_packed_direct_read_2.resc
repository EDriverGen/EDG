:name: sht30_eval
:description: I2C vector test for sht30

$bin = @<RUN_DIR>/attempts/001/stage/out/sht30_threadx.elf

mach create "sht30_eval"
machine LoadPlatformDescription @<RUN_DIR>/attempts/001/stage/probe/platform_mechanical_packed_direct_read_2.repl

sysbus LoadELF $bin

showAnalyzer usart2

start
sleep 20

pause
quit
